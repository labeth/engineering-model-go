        payload = "{\"namespace\":\"engineering-model-go\",\"owner\":\"engineering-model-go\",\"features\":[{\"name\":\"text\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"Where naf export is enabled, when generation run is requested, the engineering model go shall generate deterministic naf v4.1 architecture document from referenced canonical model views.\"}},{\"name\":\"notes\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"Each NAF architecture product uses an official NAF v4.1 viewpoint code and references an existing Engmod view so generated content preserves canonical identities and relationships.\"}}],\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.requirement_source\",\"target\":\"REQ-EMG-042\",\"properties\":{\"AppliesTo\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"FU-NAF-EXPORTER\"},{\"kind\":\"string\",\"string\":\"FU-VIEW-PROJECTION\"},{\"kind\":\"string\",\"string\":\"FU-CLI-ORCHESTRATION\"}]},\"ID\":{\"kind\":\"string\",\"string\":\"REQ-EMG-042\"},\"Notes\":{\"kind\":\"string\",\"string\":\"Each NAF architecture product uses an official NAF v4.1 viewpoint code and references an existing Engmod view so generated content preserves canonical identities and relationships.\"},\"Text\":{\"kind\":\"string\",\"string\":\"Where naf export is enabled, when generation run is requested, the engineering model go shall generate deterministic naf v4.1 architecture document from referenced canonical model views.\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.requirement_source\"}";
    }
