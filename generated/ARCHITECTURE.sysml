ring\",\"string\":\"Enforces a workspace boundary and rejects references that escape it or form a cycle.\"},\"Title\":{\"kind\":\"string\",\"string\":\"System Composition Security\"}}},\"traceability\":{\"kind\":\"object\",\"object\":{\"Narrative\":{\"kind\":\"string\",\"string\":\"Reports cycle, out-of-workspace, missing-ref, clone-failed, and unsatisfied-require diagnostics for every subsystem reference.\"},\"Title\":{\"kind\":\"string\",\"string\":\"System Composition Traceability\"}}}}}}},{\"namespace\":\"engineering\",\"type\":\"engineering.catalog.functional_units\",\"target\":\"FU-SYSTEM-COMPOSITION\",\"properties\":{\"Aliases\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"composition\"}]},\"Definition\":{\"kind\":\"string\",\"string\":\"Resolves downward subsystem references from local subdirectories or external git repositories and composes a federated system-of-systems model.\"},\"ID\":{\"kind\":\"string\",\"string\":\"FU-SYSTEM-COMPOSITION\"},\"Name\":{\"kind\":\"string\",\"string\":\"system composition\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.functional_unit\"}";
