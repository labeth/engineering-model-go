    }
    attribute 'AV-PATH-TRAVERSAL-IN-MCP';

    @EngineeringElement {
        sourceId = "AV-SCHEMA-SUPPLY-CHAIN-TAMPER";
        conceptKind = "engineering_extension";
        payload = "{\"namespace\":\"engineering-model-go\",\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.attack_vector\",\"target\":\"AV-SCHEMA-SUPPLY-CHAIN-TAMPER\",\"properties\":{\"Description\":{\"kind\":\"string\",\"string\":\"Drift or tampering in external schemas used by export validation.\"},\"ID\":{\"kind\":\"string\",\"string\":\"AV-SCHEMA-SUPPLY-CHAIN-TAMPER\"},\"Name\":{\"kind\":\"string\",\"string\":\"Schema Supply Chain Tamper\"}}},{\"namespace\":\"engineering\",\"type\":\"engineering.catalog.attack_vectors\",\"target\":\"AV-SCHEMA-SUPPLY-CHAIN-TAMPER\",\"properties\":{\"Aliases\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"schema tamper\"}]},\"Definition\":{\"kind\":\"string\",\"string\":\"Tampering or drift in external schemas used for export validation.\"},\"ID\":{\"kind\":\"string\",\"string\":\"AV-SCHEMA-SUPPLY-CHAIN-TAMPER\"},\"Name\":{\"kind\":\"string\",\"string\":\"schema supply chain tamper\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.attack_vector\",\"targets\":[\"engineering-model-go\"]}";
    }
    attribute 'AV-SCHEMA-SUPPLY-CHAIN-TAMPER';

