        payload = "{\"namespace\":\"engineering-model-go\",\"owner\":\"engineering-model-go\",\"features\":[{\"name\":\"text\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"While ci validation mode is active, when generation run is requested, the engineering model go shall reject architecture model that violates model authoring contract before artifact generated event is raised.\"}},{\"name\":\"notes\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"Violations include unsupported schema versions, conflicting legacy and explicit catalog references, empty explicit document references, and missing required companion documents.\"}}],\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.requirement_source\",\"target\":\"REQ-EMG-046\",\"properties\":{\"AppliesTo\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"FU-MODEL-LOADER\"},{\"kind\":\"string\",\"string\":\"FU-VALIDATION-ENGINE\"},{\"kind\":\"string\",\"string\":\"FU-CLI-ORCHESTRATION\"}]},\"ID\":{\"kind\":\"string\",\"string\":\"REQ-EMG-046\"},\"Notes\":{\"kind\":\"string\",\"string\":\"Violations include unsupported schema versions, conflicting legacy and explicit catalog references, empty explicit document references, and missing required companion documents.\"},\"Text\":{\"kind\":\"string\",\"string\":\"While ci validation mode is active, when generation run is requested, the engineering model go shall reject architecture model that violates model authoring contract before artifact generated event is raised.\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.requirement_source\"}";
