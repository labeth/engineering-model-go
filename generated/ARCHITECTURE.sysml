        payload = "{\"namespace\":\"engineering-model-go\",\"owner\":\"engineering-model-go\",\"features\":[{\"name\":\"text\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"Where external schema dependencies are available, when generation run is requested, the engineering model go shall fail validation if schema checks do not match expected constraints.\"}},{\"name\":\"notes\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"Protect export integrity when schema trust fails.\"}}],\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.requirement_source\",\"target\":\"REQ-EMG-011\",\"properties\":{\"AppliesTo\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"FU-THREAT-EXPORTER\"},{\"kind\":\"string\",\"string\":\"FU-STRUCTURIZR-EXPORTER\"},{\"kind\":\"string\",\"string\":\"FU-VALIDATION-ENGINE\"}]},\"ID\":{\"kind\":\"string\",\"string\":\"REQ-EMG-011\"},\"Notes\":{\"kind\":\"string\",\"string\":\"Protect export integrity when schema trust fails.\"},\"Text\":{\"kind\":\"string\",\"string\":\"Where external schema dependencies are available, when generation run is requested, the engineering model go shall fail validation if schema checks do not match expected constraints.\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.requirement_source\"}";
    }
