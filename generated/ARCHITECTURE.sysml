    @EngineeringElement {
        sourceId = "REQ-EMG-044";
        conceptKind = "requirement_definition";
        payload = "{\"namespace\":\"engineering-model-go\",\"owner\":\"engineering-model-go\",\"features\":[{\"name\":\"text\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"When model updated event is received, the engineering model go shall load architecture model plus catalog document plus requirements document plus design document plus decisions document according to model authoring contract.\"}},{\"name\":\"notes\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"Every canonical YAML document has an effective schema version. Explicit architecture.model.documents references are preferred, while legacy baseCatalogRef and established companion filenames remain supported as migration adapters.\"}}],\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.requirement_source\",\"target\":\"REQ-EMG-044\",\"properties\":{\"AppliesTo\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"FU-MODEL-LOADER\"},{\"kind\":\"string\",\"string\":\"FU-VALIDATION-ENGINE\"},{\"kind\":\"string\",\"string\":\"FU-CLI-ORCHESTRATION\"}]},\"ID\":{\"kind\":\"string\",\"string\":\"REQ-EMG-044\"},\"Notes\":{\"kind\":\"string\",\"string\":\"Every canonical YAML document has an effective schema version. Explicit architecture.model.documents references are preferred, while legacy baseCatalogRef and established companion filenames remain supported as migration adapters.\"},\"Text\":{\"kind\":\"string\",\"string\":\"When model updated event is received, the engineering model go shall load architecture model plus catalog document plus requirements document plus design document plus decisions document according to model authoring contract.\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.requirement_source\"}";
    }
    requirement def 'REQ-EMG-044' {
        attribute 'text' : 'String' = "When model updated event is received, the engineering model go shall load architecture model plus catalog document plus requirements document plus design document plus decisions document according to model authoring contract.";
        attribute 'notes' : 'String' = "Every canonical YAML document has an effective schema version. Explicit architecture.model.documents references are preferred, while legacy baseCatalogRef and established companion filenames remain supported as migration adapters.";
    }

    @EngineeringElement {
