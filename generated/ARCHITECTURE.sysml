    @EngineeringElement {
        sourceId = "REQ-EMG-016";
        conceptKind = "requirement_definition";
        payload = "{\"namespace\":\"engineering-model-go\",\"owner\":\"engineering-model-go\",\"features\":[{\"name\":\"text\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"Where system composition is enabled, when generation run is requested, the engineering model go shall resolve the subsystem references declared by the parent system from local subdirectory paths.\"}},{\"name\":\"notes\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"Recursive system-of-systems composition; local subdirectory references, with external git repositories cloned into the .engmod cache (REQ-EMG-027, ADR-EMG-008, ADR-EMG-010).\"}}],\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.requirement_source\",\"target\":\"REQ-EMG-016\",\"properties\":{\"AppliesTo\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"FU-SYSTEM-COMPOSITION\"},{\"kind\":\"string\",\"string\":\"FU-MODEL-LOADER\"}]},\"ID\":{\"kind\":\"string\",\"string\":\"REQ-EMG-016\"},\"Notes\":{\"kind\":\"string\",\"string\":\"Recursive system-of-systems composition; local subdirectory references, with external git repositories cloned into the .engmod cache (REQ-EMG-027, ADR-EMG-008, ADR-EMG-010).\"},\"Text\":{\"kind\":\"string\",\"string\":\"Where system composition is enabled, when generation run is requested, the engineering model go shall resolve the subsystem references declared by the parent system from local subdirectory paths.\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.requirement_source\"}";
    }
    requirement def 'REQ-EMG-016' {
        attribute 'text' : 'String' = "Where system composition is enabled, when generation run is requested, the engineering model go shall resolve the subsystem references declared by the parent system from local subdirectory paths.";
        attribute 'notes' : 'String' = "Recursive system-of-systems composition; local subdirectory references, with external git repositories cloned into the .engmod cache (REQ-EMG-027, ADR-EMG-008, ADR-EMG-010).";
    }

    @EngineeringElement {
        sourceId = "REQ-EMG-017";
        conceptKind = "requirement_definition";
        payload = "{\"namespace\":\"engineering-model-go\",\"owner\":\"engineering-model-go\",\"features\":[{\"name\":\"text\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"Where system composition is enabled, when generation run is requested, the engineering model go shall reject any subsystem reference that resolves outside the repository workspace boundary.\"}},{\"name\":\"notes\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"Downward-only references remain within the workspace; mirrors the MCP path-boundary guardrail.\"}}],\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.requirement_source\",\"target\":\"REQ-EMG-017\",\"properties\":{\"AppliesTo\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"FU-SYSTEM-COMPOSITION\"}]},\"ID\":{\"kind\":\"string\",\"string\":\"REQ-EMG-017\"},\"Notes\":{\"kind\":\"string\",\"string\":\"Downward-only references remain within the workspace; mirrors the MCP path-boundary guardrail.\"},\"Text\":{\"kind\":\"string\",\"string\":\"Where system composition is enabled, when generation run is requested, the engineering model go shall reject any subsystem reference that resolves outside the repository workspace boundary.\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.requirement_source\"}";
    }
    requirement def 'REQ-EMG-017' {
        attribute 'text' : 'String' = "Where system composition is enabled, when generation run is requested, the engineering model go shall reject any subsystem reference that resolves outside the repository workspace boundary.";
        attribute 'notes' : 'String' = "Downward-only references remain within the workspace; mirrors the MCP path-boundary guardrail.";
    }

    @EngineeringElement {
        sourceId = "REQ-EMG-018";
        conceptKind = "requirement_definition";
        payload = "{\"namespace\":\"engineering-model-go\",\"owner\":\"engineering-model-go\",\"features\":[{\"name\":\"text\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"Where system composition is enabled, when generation run is requested, the engineering model go shall reject a subsystem reference graph that contains a cycle.\"}},{\"name\":\"notes\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"Subsystem references must form a directed acyclic graph (ADR-EMG-009).\"}}],\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.requirement_source\",\"target\":\"REQ-EMG-018\",\"properties\":{\"AppliesTo\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"FU-SYSTEM-COMPOSITION\"},{\"kind\":\"string\",\"string\":\"FU-VALIDATION-ENGINE\"}]},\"ID\":{\"kind\":\"string\",\"string\":\"REQ-EMG-018\"},\"Notes\":{\"kind\":\"string\",\"string\":\"Subsystem references must form a directed acyclic graph (ADR-EMG-009).\"},\"Text\":{\"kind\":\"string\",\"string\":\"Where system composition is enabled, when generation run is requested, the engineering model go shall reject a subsystem reference graph that contains a cycle.\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.requirement_source\"}";
    }
    requirement def 'REQ-EMG-018' {
        attribute 'text' : 'String' = "Where system composition is enabled, when generation run is requested, the engineering model go shall reject a subsystem reference graph that contains a cycle.";
        attribute 'notes' : 'String' = "Subsystem references must form a directed acyclic graph (ADR-EMG-009).";
    }

    @EngineeringElement {
        sourceId = "REQ-EMG-019";
        conceptKind = "requirement_definition";
        payload = "{\"namespace\":\"engineering-model-go\",\"owner\":\"engineering-model-go\",\"features\":[{\"name\":\"text\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"Where system composition is enabled, when generation run is requested, the engineering model go shall resolve cross-system references using subsystem-qualified identifiers.\"}},{\"name\":\"notes\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"Identifiers are scoped per system; cross-system references are qualified by subsystem to avoid collisions.\"}}],\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.requirement_source\",\"target\":\"REQ-EMG-019\",\"properties\":{\"AppliesTo\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"FU-SYSTEM-COMPOSITION\"},{\"kind\":\"string\",\"string\":\"FU-ALLOCATION-TRACE\"}]},\"ID\":{\"kind\":\"string\",\"string\":\"REQ-EMG-019\"},\"Notes\":{\"kind\":\"string\",\"string\":\"Identifiers are scoped per system; cross-system references are qualified by subsystem to avoid collisions.\"},\"Text\":{\"kind\":\"string\",\"string\":\"Where system composition is enabled, when generation run is requested, the engineering model go shall resolve cross-system references using subsystem-qualified identifiers.\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.requirement_source\"}";
    }
    requirement def 'REQ-EMG-019' {
        attribute 'text' : 'String' = "Where system composition is enabled, when generation run is requested, the engineering model go shall resolve cross-system references using subsystem-qualified identifiers.";
        attribute 'notes' : 'String' = "Identifiers are scoped per system; cross-system references are qualified by subsystem to avoid collisions.";
    }

    @EngineeringElement {
        sourceId = "REQ-EMG-020";
        conceptKind = "requirement_definition";
        payload = "{\"namespace\":\"engineering-model-go\",\"owner\":\"engineering-model-go\",\"features\":[{\"name\":\"text\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"Where system composition is enabled, when generation run is requested, the engineering model go shall materialize parent-to-subsystem allocation traceability in the composed output without modifying any subsystem model.\"}},{\"name\":\"notes\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"A subsystem is parent-agnostic; parent allocation is materialized only in composed artifacts, never written back to the child (ADR-EMG-009, ADR-EMG-011).\"}}],\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.requirement_source\",\"target\":\"REQ-EMG-020\",\"properties\":{\"AppliesTo\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"FU-ALLOCATION-TRACE\"}]},\"ID\":{\"kind\":\"string\",\"string\":\"REQ-EMG-020\"},\"Notes\":{\"kind\":\"string\",\"string\":\"A subsystem is parent-agnostic; parent allocation is materialized only in composed artifacts, never written back to the child (ADR-EMG-009, ADR-EMG-011).\"},\"Text\":{\"kind\":\"string\",\"string\":\"Where system composition is enabled, when generation run is requested, the engineering model go shall materialize parent-to-subsystem allocation traceability in the composed output without modifying any subsystem model.\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.requirement_source\"}";
    }
    requirement def 'REQ-EMG-020' {
        attribute 'text' : 'String' = "Where system composition is enabled, when generation run is requested, the engineering model go shall materialize parent-to-subsystem allocation traceability in the composed output without modifying any subsystem model.";
        attribute 'notes' : 'String' = "A subsystem is parent-agnostic; parent allocation is materialized only in composed artifacts, never written back to the child (ADR-EMG-009, ADR-EMG-011).";
    }

    @EngineeringElement {
        sourceId = "REQ-EMG-021";
        conceptKind = "requirement_definition";
        payload = "{\"namespace\":\"engineering-model-go\",\"owner\":\"engineering-model-go\",\"features\":[{\"name\":\"text\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"Where system composition is enabled, when generation run is requested, the engineering model go shall report each subsystem required interface that the parent system does not satisfy.\"}},{\"name\":\"notes\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"Subsystems publish a provides-and-requires contract; the parent must satisfy each required interface.\"}}],\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.requirement_source\",\"target\":\"REQ-EMG-021\",\"properties\":{\"AppliesTo\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"FU-ALLOCATION-TRACE\"},{\"kind\":\"string\",\"string\":\"FU-VALIDATION-ENGINE\"}]},\"ID\":{\"kind\":\"string\",\"string\":\"REQ-EMG-021\"},\"Notes\":{\"kind\":\"string\",\"string\":\"Subsystems publish a provides-and-requires contract; the parent must satisfy each required interface.\"},\"Text\":{\"kind\":\"string\",\"string\":\"Where system composition is enabled, when generation run is requested, the engineering model go shall report each subsystem required interface that the parent system does not satisfy.\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.requirement_source\"}";
    }
    requirement def 'REQ-EMG-021' {
        attribute 'text' : 'String' = "Where system composition is enabled, when generation run is requested, the engineering model go shall report each subsystem required interface that the parent system does not satisfy.";
        attribute 'notes' : 'String' = "Subsystems publish a provides-and-requires contract; the parent must satisfy each required interface.";
    }

    @EngineeringElement {
        sourceId = "REQ-EMG-022";
        conceptKind = "requirement_definition";
        payload = "{\"namespace\":\"engineering-model-go\",\"owner\":\"engineering-model-go\",\"features\":[{\"name\":\"text\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"Where system composition is enabled, when generation run is requested, the engineering model go shall reject an allocation that targets a subsystem identifier not published in the subsystem contract.\"}},{\"name\":\"notes\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"Parents may bind only to a subsystem's public contract surface, not its internal identifiers.\"}}],\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.requirement_source\",\"target\":\"REQ-EMG-022\",\"properties\":{\"AppliesTo\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"FU-ALLOCATION-TRACE\"},{\"kind\":\"string\",\"string\":\"FU-VALIDATION-ENGINE\"}]},\"ID\":{\"kind\":\"string\",\"string\":\"REQ-EMG-022\"},\"Notes\":{\"kind\":\"string\",\"string\":\"Parents may bind only to a subsystem's public contract surface, not its internal identifiers.\"},\"Text\":{\"kind\":\"string\",\"string\":\"Where system composition is enabled, when generation run is requested, the engineering model go shall reject an allocation that targets a subsystem identifier not published in the subsystem contract.\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.requirement_source\"}";
    }
    requirement def 'REQ-EMG-022' {
        attribute 'text' : 'String' = "Where system composition is enabled, when generation run is requested, the engineering model go shall reject an allocation that targets a subsystem identifier not published in the subsystem contract.";
        attribute 'notes' : 'String' = "Parents may bind only to a subsystem's public contract surface, not its internal identifiers.";
    }

    @EngineeringElement {
        sourceId = "REQ-EMG-023";
        conceptKind = "requirement_definition";
        payload = "{\"namespace\":\"engineering-model-go\",\"owner\":\"engineering-model-go\",\"features\":[{\"name\":\"text\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"When generation run is requested, the engineering model go shall flag any requirement that links to another requirement in the same document.\"}},{\"name\":\"notes\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"Requirements carry no tiers. A requirement is either delegated to a subsystem through a downward composition allocation or implemented here, and the delegation link alone tells the two apart. Linking requirements to one another inside a document recreates tier coupling and is confusing across system boundaries, so it is flagged.\"}}],\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.requirement_source\",\"target\":\"REQ-EMG-023\",\"properties\":{\"AppliesTo\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"FU-VALIDATION-ENGINE\"},{\"kind\":\"string\",\"string\":\"FU-ALLOCATION-TRACE\"}]},\"ID\":{\"kind\":\"string\",\"string\":\"REQ-EMG-023\"},\"Notes\":{\"kind\":\"string\",\"string\":\"Requirements carry no tiers. A requirement is either delegated to a subsystem through a downward composition allocation or implemented here, and the delegation link alone tells the two apart. Linking requirements to one another inside a document recreates tier coupling and is confusing across system boundaries, so it is flagged.\"},\"Text\":{\"kind\":\"string\",\"string\":\"When generation run is requested, the engineering model go shall flag any requirement that links to another requirement in the same document.\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.requirement_source\"}";
    }
    requirement def 'REQ-EMG-023' {
        attribute 'text' : 'String' = "When generation run is requested, the engineering model go shall flag any requirement that links to another requirement in the same document.";
        attribute 'notes' : 'String' = "Requirements carry no tiers. A requirement is either delegated to a subsystem through a downward composition allocation or implemented here, and the delegation link alone tells the two apart. Linking requirements to one another inside a document recreates tier coupling and is confusing across system boundaries, so it is flagged.";
    }

    @EngineeringElement {
        sourceId = "REQ-EMG-024";
        conceptKind = "requirement_definition";
        payload = "{\"namespace\":\"engineering-model-go\",\"owner\":\"engineering-model-go\",\"features\":[{\"name\":\"text\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"Where hardware interfaces are authored, when generation run is requested, the engineering model go shall render the hardware to software interface allocation view.\"}},{\"name\":\"notes\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"Hardware items and hardware interfaces capture the HW/SW interface (ICD/IRS) for the interface-control view.\"}}],\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.requirement_source\",\"target\":\"REQ-EMG-024\",\"properties\":{\"AppliesTo\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"FU-ASCIIDOC-GENERATOR\"},{\"kind\":\"string\",\"string\":\"FU-VIEW-PROJECTION\"}]},\"ID\":{\"kind\":\"string\",\"string\":\"REQ-EMG-024\"},\"Notes\":{\"kind\":\"string\",\"string\":\"Hardware items and hardware interfaces capture the HW/SW interface (ICD/IRS) for the interface-control view.\"},\"Text\":{\"kind\":\"string\",\"string\":\"Where hardware interfaces are authored, when generation run is requested, the engineering model go shall render the hardware to software interface allocation view.\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.requirement_source\"}";
    }
    requirement def 'REQ-EMG-024' {
        attribute 'text' : 'String' = "Where hardware interfaces are authored, when generation run is requested, the engineering model go shall render the hardware to software interface allocation view.";
        attribute 'notes' : 'String' = "Hardware items and hardware interfaces capture the HW/SW interface (ICD/IRS) for the interface-control view.";
    }

    @EngineeringElement {
        sourceId = "REQ-EMG-025";
        conceptKind = "requirement_definition";
        payload = "{\"namespace\":\"engineering-model-go\",\"owner\":\"engineering-model-go\",\"features\":[{\"name\":\"text\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"Where system composition is enabled, when generation run is requested, the engineering model go shall produce a system requirement allocation matrix aggregated across the composed subsystems.\"}},{\"name\":\"notes\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"Aggregate roll-up generation mode for the integrating system.\"}}],\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.requirement_source\",\"target\":\"REQ-EMG-025\",\"properties\":{\"AppliesTo\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"FU-ALLOCATION-TRACE\"},{\"kind\":\"string\",\"string\":\"FU-ASCIIDOC-GENERATOR\"}]},\"ID\":{\"kind\":\"string\",\"string\":\"REQ-EMG-025\"},\"Notes\":{\"kind\":\"string\",\"string\":\"Aggregate roll-up generation mode for the integrating system.\"},\"Text\":{\"kind\":\"string\",\"string\":\"Where system composition is enabled, when generation run is requested, the engineering model go shall produce a system requirement allocation matrix aggregated across the composed subsystems.\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.requirement_source\"}";
    }
    requirement def 'REQ-EMG-025' {
        attribute 'text' : 'String' = "Where system composition is enabled, when generation run is requested, the engineering model go shall produce a system requirement allocation matrix aggregated across the composed subsystems.";
        attribute 'notes' : 'String' = "Aggregate roll-up generation mode for the integrating system.";
    }

    @EngineeringElement {
        sourceId = "REQ-EMG-026";
        conceptKind = "requirement_definition";
        payload = "{\"namespace\":\"engineering-model-go\",\"owner\":\"engineering-model-go\",\"features\":[{\"name\":\"text\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"Where system composition is enabled, when generation run is requested, the engineering model go shall render in the requirement view the delegation link from each delegated requirement to the specific subsystem requirement that satisfies it.\"}},{\"name\":\"notes\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"A provided contract entry names (ref) the subsystem requirement that realizes it, so a parent delegation traces to exactly the requirement that satisfies it. An allocated capability with no such ref is flagged as untraceable, and a ref to a requirement the subsystem does not define is rejected.\"}}],\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.requirement_source\",\"target\":\"REQ-EMG-026\",\"properties\":{\"AppliesTo\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"FU-ALLOCATION-TRACE\"},{\"kind\":\"string\",\"string\":\"FU-ASCIIDOC-GENERATOR\"},{\"kind\":\"string\",\"string\":\"FU-VALIDATION-ENGINE\"}]},\"ID\":{\"kind\":\"string\",\"string\":\"REQ-EMG-026\"},\"Notes\":{\"kind\":\"string\",\"string\":\"A provided contract entry names (ref) the subsystem requirement that realizes it, so a parent delegation traces to exactly the requirement that satisfies it. An allocated capability with no such ref is flagged as untraceable, and a ref to a requirement the subsystem does not define is rejected.\"},\"Text\":{\"kind\":\"string\",\"string\":\"Where system composition is enabled, when generation run is requested, the engineering model go shall render in the requirement view the delegation link from each delegated requirement to the specific subsystem requirement that satisfies it.\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.requirement_source\"}";
    }
    requirement def 'REQ-EMG-026' {
        attribute 'text' : 'String' = "Where system composition is enabled, when generation run is requested, the engineering model go shall render in the requirement view the delegation link from each delegated requirement to the specific subsystem requirement that satisfies it.";
        attribute 'notes' : 'String' = "A provided contract entry names (ref) the subsystem requirement that realizes it, so a parent delegation traces to exactly the requirement that satisfies it. An allocated capability with no such ref is flagged as untraceable, and a ref to a requirement the subsystem does not define is rejected.";
    }

    @EngineeringElement {
        sourceId = "REQ-EMG-027";
        conceptKind = "requirement_definition";
        payload = "{\"namespace\":\"engineering-model-go\",\"owner\":\"engineering-model-go\",\"features\":[{\"name\":\"text\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"Where system composition is enabled, when generation run is requested, the engineering model go shall resolve an external git subsystem reference by cloning the repository into the workspace .engmod cache.\"}},{\"name\":\"notes\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"A subsystem may reference an external repository with git (and an optional rev and path). The model is cloned once into .engmod/subsystems/\\u003cid\\u003e — a gitignored, temporary cache reused while it points at the same repository — and resolved like a local subsystem, giving a full cross-repository composed view. References stay downward-only.\"}}],\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.requirement_source\",\"target\":\"REQ-EMG-027\",\"properties\":{\"AppliesTo\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"FU-SYSTEM-COMPOSITION\"},{\"kind\":\"string\",\"string\":\"FU-MODEL-LOADER\"}]},\"ID\":{\"kind\":\"string\",\"string\":\"REQ-EMG-027\"},\"Notes\":{\"kind\":\"string\",\"string\":\"A subsystem may reference an external repository with git (and an optional rev and path). The model is cloned once into .engmod/subsystems/\\u003cid\\u003e — a gitignored, temporary cache reused while it points at the same repository — and resolved like a local subsystem, giving a full cross-repository composed view. References stay downward-only.\"},\"Text\":{\"kind\":\"string\",\"string\":\"Where system composition is enabled, when generation run is requested, the engineering model go shall resolve an external git subsystem reference by cloning the repository into the workspace .engmod cache.\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.requirement_source\"}";
    }
    requirement def 'REQ-EMG-027' {
        attribute 'text' : 'String' = "Where system composition is enabled, when generation run is requested, the engineering model go shall resolve an external git subsystem reference by cloning the repository into the workspace .engmod cache.";
        attribute 'notes' : 'String' = "A subsystem may reference an external repository with git (and an optional rev and path). The model is cloned once into .engmod/subsystems/<id> — a gitignored, temporary cache reused while it points at the same repository — and resolved like a local subsystem, giving a full cross-repository composed view. References stay downward-only.";
    }

    @EngineeringElement {
        sourceId = "REQ-EMG-028";
        conceptKind = "requirement_definition";
        payload = "{\"namespace\":\"engineering-model-go\",\"owner\":\"engineering-model-go\",\"features\":[{\"name\":\"text\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"When generation run is requested, the engineering model go shall reject a code trace link that resolves to no requirement or model element.\"}},{\"name\":\"notes\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"Code markers (TRLC-LINKS to a requirement, ENGMODEL-LINKS to a model element) are existence-checked against the model, not only shape-checked, so a link to a deleted or mistyped id is a dangling link and fails the build. A trace link is only checked for the model that owns its code (see REQ-EMG-030 scoping).\"}}],\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.requirement_source\",\"target\":\"REQ-EMG-028\",\"properties\":{\"AppliesTo\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"FU-VALIDATION-ENGINE\"},{\"kind\":\"string\",\"string\":\"FU-CODEMAP-INFERENCE\"},{\"kind\":\"string\",\"string\":\"FU-ALLOCATION-TRACE\"}]},\"ID\":{\"kind\":\"string\",\"string\":\"REQ-EMG-028\"},\"Notes\":{\"kind\":\"string\",\"string\":\"Code markers (TRLC-LINKS to a requirement, ENGMODEL-LINKS to a model element) are existence-checked against the model, not only shape-checked, so a link to a deleted or mistyped id is a dangling link and fails the build. A trace link is only checked for the model that owns its code (see REQ-EMG-030 scoping).\"},\"Text\":{\"kind\":\"string\",\"string\":\"When generation run is requested, the engineering model go shall reject a code trace link that resolves to no requirement or model element.\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.requirement_source\"}";
    }
    requirement def 'REQ-EMG-028' {
        attribute 'text' : 'String' = "When generation run is requested, the engineering model go shall reject a code trace link that resolves to no requirement or model element.";
        attribute 'notes' : 'String' = "Code markers (TRLC-LINKS to a requirement, ENGMODEL-LINKS to a model element) are existence-checked against the model, not only shape-checked, so a link to a deleted or mistyped id is a dangling link and fails the build. A trace link is only checked for the model that owns its code (see REQ-EMG-030 scoping).";
    }

    @EngineeringElement {
        sourceId = "REQ-EMG-029";
        conceptKind = "requirement_definition";
        payload = "{\"namespace\":\"engineering-model-go\",\"owner\":\"engineering-model-go\",\"features\":[{\"name\":\"text\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"When generation run is requested, the engineering model go shall flag each requirement that is traced by neither code nor verification nor a downward delegation.\"}},{\"name\":\"notes\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"An orphan requirement has no implementing code symbol, no verification, and is not delegated to a subsystem; it is a coverage gap surfaced as a warning so it is visible without breaking the build.\"}}],\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.requirement_source\",\"target\":\"REQ-EMG-029\",\"properties\":{\"AppliesTo\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"FU-VALIDATION-ENGINE\"},{\"kind\":\"string\",\"string\":\"FU-ALLOCATION-TRACE\"}]},\"ID\":{\"kind\":\"string\",\"string\":\"REQ-EMG-029\"},\"Notes\":{\"kind\":\"string\",\"string\":\"An orphan requirement has no implementing code symbol, no verification, and is not delegated to a subsystem; it is a coverage gap surfaced as a warning so it is visible without breaking the build.\"},\"Text\":{\"kind\":\"string\",\"string\":\"When generation run is requested, the engineering model go shall flag each requirement that is traced by neither code nor verification nor a downward delegation.\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.requirement_source\"}";
    }
    requirement def 'REQ-EMG-029' {
        attribute 'text' : 'String' = "When generation run is requested, the engineering model go shall flag each requirement that is traced by neither code nor verification nor a downward delegation.";
        attribute 'notes' : 'String' = "An orphan requirement has no implementing code symbol, no verification, and is not delegated to a subsystem; it is a coverage gap surfaced as a warning so it is visible without breaking the build.";
    }

    @EngineeringElement {
        sourceId = "REQ-EMG-030";
        conceptKind = "requirement_definition";
        payload = "{\"namespace\":\"engineering-model-go\",\"owner\":\"engineering-model-go\",\"features\":[{\"name\":\"text\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"When generation run is requested, the engineering model go shall export a machine-readable traceability matrix that links each requirement to its implementing code and verification and delegated subsystem requirement.\"}},{\"name\":\"notes\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"One consolidated matrix (JSON) replaces having to read it out of prose and diagrams. Code is attributed to the model whose architecture.yml is its nearest enclosing root, so a parent model never validates or counts a child model's trace links (monorepo scoping).\"}}],\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.requirement_source\",\"target\":\"REQ-EMG-030\",\"properties\":{\"AppliesTo\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"FU-ALLOCATION-TRACE\"},{\"kind\":\"string\",\"string\":\"FU-CODEMAP-INFERENCE\"}]},\"ID\":{\"kind\":\"string\",\"string\":\"REQ-EMG-030\"},\"Notes\":{\"kind\":\"string\",\"string\":\"One consolidated matrix (JSON) replaces having to read it out of prose and diagrams. Code is attributed to the model whose architecture.yml is its nearest enclosing root, so a parent model never validates or counts a child model's trace links (monorepo scoping).\"},\"Text\":{\"kind\":\"string\",\"string\":\"When generation run is requested, the engineering model go shall export a machine-readable traceability matrix that links each requirement to its implementing code and verification and delegated subsystem requirement.\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.requirement_source\"}";
    }
    requirement def 'REQ-EMG-030' {
        attribute 'text' : 'String' = "When generation run is requested, the engineering model go shall export a machine-readable traceability matrix that links each requirement to its implementing code and verification and delegated subsystem requirement.";
        attribute 'notes' : 'String' = "One consolidated matrix (JSON) replaces having to read it out of prose and diagrams. Code is attributed to the model whose architecture.yml is its nearest enclosing root, so a parent model never validates or counts a child model's trace links (monorepo scoping).";
    }

    @EngineeringElement {
        sourceId = "REQ-EMG-031";
        conceptKind = "requirement_definition";
        payload = "{\"namespace\":\"engineering-model-go\",\"owner\":\"engineering-model-go\",\"features\":[{\"name\":\"text\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"When requirements delta is received, the engineering model go shall strictly validate requirements delta schema plus stable identifier operation uniqueness.\"}},{\"name\":\"notes\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"Version 1 supports add, whole-entity update, and remove operations. Unknown fields, empty operations, duplicate operations, adds of existing IDs, and updates or removals of missing IDs are rejected.\"}}],\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.requirement_source\",\"target\":\"REQ-EMG-031\",\"properties\":{\"AppliesTo\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"FU-MODEL-CHANGE\"},{\"kind\":\"string\",\"string\":\"FU-MODEL-LOADER\"}]},\"ID\":{\"kind\":\"string\",\"string\":\"REQ-EMG-031\"},\"Notes\":{\"kind\":\"string\",\"string\":\"Version 1 supports add, whole-entity update, and remove operations. Unknown fields, empty operations, duplicate operations, adds of existing IDs, and updates or removals of missing IDs are rejected.\"},\"Text\":{\"kind\":\"string\",\"string\":\"When requirements delta is received, the engineering model go shall strictly validate requirements delta schema plus stable identifier operation uniqueness.\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.requirement_source\"}";
    }
    requirement def 'REQ-EMG-031' {
        attribute 'text' : 'String' = "When requirements delta is received, the engineering model go shall strictly validate requirements delta schema plus stable identifier operation uniqueness.";
        attribute 'notes' : 'String' = "Version 1 supports add, whole-entity update, and remove operations. Unknown fields, empty operations, duplicate operations, adds of existing IDs, and updates or removals of missing IDs are rejected.";
    }

    @EngineeringElement {
        sourceId = "REQ-EMG-032";
        conceptKind = "requirement_definition";
        payload = "{\"namespace\":\"engineering-model-go\",\"owner\":\"engineering-model-go\",\"features\":[{\"name\":\"text\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"While dry run mode is active, when requirements delta is received, the engineering model go shall validate candidate architecture model without modifying requirements document.\"}},{\"name\":\"notes\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"The candidate reuses complete-model structural, catalog, EARS, and internal-link validation before any write is permitted.\"}}],\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.requirement_source\",\"target\":\"REQ-EMG-032\",\"properties\":{\"AppliesTo\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"FU-MODEL-CHANGE\"},{\"kind\":\"string\",\"string\":\"FU-VALIDATION-ENGINE\"}]},\"ID\":{\"kind\":\"string\",\"string\":\"REQ-EMG-032\"},\"Notes\":{\"kind\":\"string\",\"string\":\"The candidate reuses complete-model structural, catalog, EARS, and internal-link validation before any write is permitted.\"},\"Text\":{\"kind\":\"string\",\"string\":\"While dry run mode is active, when requirements delta is received, the engineering model go shall validate candidate architecture model without modifying requirements document.\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.requirement_source\"}";
    }
    requirement def 'REQ-EMG-032' {
        attribute 'text' : 'String' = "While dry run mode is active, when requirements delta is received, the engineering model go shall validate candidate architecture model without modifying requirements document.";
        attribute 'notes' : 'String' = "The candidate reuses complete-model structural, catalog, EARS, and internal-link validation before any write is permitted.";
    }

    @EngineeringElement {
        sourceId = "REQ-EMG-033";
        conceptKind = "requirement_definition";
        payload = "{\"namespace\":\"engineering-model-go\",\"owner\":\"engineering-model-go\",\"features\":[{\"name\":\"text\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"While model is valid, when requirements delta apply is requested, the engineering model go shall atomically replace requirements document.\"}},{\"name\":\"notes\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"The YAML AST merger preserves unchanged nodes and comments. Atomic replacement preserves file permissions and refuses a candidate with blocking diagnostics.\"}}],\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.requirement_source\",\"target\":\"REQ-EMG-033\",\"properties\":{\"AppliesTo\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"FU-MODEL-CHANGE\"},{\"kind\":\"string\",\"string\":\"FU-VALIDATION-ENGINE\"},{\"kind\":\"string\",\"string\":\"FU-CLI-ORCHESTRATION\"}]},\"ID\":{\"kind\":\"string\",\"string\":\"REQ-EMG-033\"},\"Notes\":{\"kind\":\"string\",\"string\":\"The YAML AST merger preserves unchanged nodes and comments. Atomic replacement preserves file permissions and refuses a candidate with blocking diagnostics.\"},\"Text\":{\"kind\":\"string\",\"string\":\"While model is valid, when requirements delta apply is requested, the engineering model go shall atomically replace requirements document.\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.requirement_source\"}";
    }
    requirement def 'REQ-EMG-033' {
        attribute 'text' : 'String' = "While model is valid, when requirements delta apply is requested, the engineering model go shall atomically replace requirements document.";
        attribute 'notes' : 'String' = "The YAML AST merger preserves unchanged nodes and comments. Atomic replacement preserves file permissions and refuses a candidate with blocking diagnostics.";
    }

    @EngineeringElement {
        sourceId = "REQ-EMG-034";
        conceptKind = "requirement_definition";
        payload = "{\"namespace\":\"engineering-model-go\",\"owner\":\"engineering-model-go\",\"features\":[{\"name\":\"text\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"When requirements delta is received, the engineering model go shall produce deterministic requirements change summary.\"}},{\"name\":\"notes\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"The summary sorts added, updated, and removed stable IDs and reports changed fields for whole-entity updates.\"}}],\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.requirement_source\",\"target\":\"REQ-EMG-034\",\"properties\":{\"AppliesTo\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"FU-MODEL-CHANGE\"},{\"kind\":\"string\",\"string\":\"FU-CLI-ORCHESTRATION\"}]},\"ID\":{\"kind\":\"string\",\"string\":\"REQ-EMG-034\"},\"Notes\":{\"kind\":\"string\",\"string\":\"The summary sorts added, updated, and removed stable IDs and reports changed fields for whole-entity updates.\"},\"Text\":{\"kind\":\"string\",\"string\":\"When requirements delta is received, the engineering model go shall produce deterministic requirements change summary.\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.requirement_source\"}";
    }
    requirement def 'REQ-EMG-034' {
        attribute 'text' : 'String' = "When requirements delta is received, the engineering model go shall produce deterministic requirements change summary.";
        attribute 'notes' : 'String' = "The summary sorts added, updated, and removed stable IDs and reports changed fields for whole-entity updates.";
    }

    @EngineeringElement {
        sourceId = "REQ-EMG-035";
        conceptKind = "requirement_definition";
        payload = "{\"namespace\":\"engineering-model-go\",\"owner\":\"engineering-model-go\",\"features\":[{\"name\":\"text\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"When model updated event is received, the engineering model go shall normalize architecture model plus requirements document into canonical semantic model.\"}},{\"name\":\"notes\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"The canonical semantic model is SysML v2 and KerML aligned. Existing Engineering Model concepts map into that model once; legacy YAML remains an input adapter during migration and must not create a parallel set of parts, interfaces, flows, requirements, allocations, or views.\"}}],\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.requirement_source\",\"target\":\"REQ-EMG-035\",\"properties\":{\"AppliesTo\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"FU-MODEL-LOADER\"},{\"kind\":\"string\",\"string\":\"FU-VALIDATION-ENGINE\"},{\"kind\":\"string\",\"string\":\"FU-SYSML-EXPORTER\"}]},\"ID\":{\"kind\":\"string\",\"string\":\"REQ-EMG-035\"},\"Notes\":{\"kind\":\"string\",\"string\":\"The canonical semantic model is SysML v2 and KerML aligned. Existing Engineering Model concepts map into that model once; legacy YAML remains an input adapter during migration and must not create a parallel set of parts, interfaces, flows, requirements, allocations, or views.\"},\"Text\":{\"kind\":\"string\",\"string\":\"When model updated event is received, the engineering model go shall normalize architecture model plus requirements document into canonical semantic model.\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.requirement_source\"}";
    }
    requirement def 'REQ-EMG-035' {
        attribute 'text' : 'String' = "When model updated event is received, the engineering model go shall normalize architecture model plus requirements document into canonical semantic model.";
        attribute 'notes' : 'String' = "The canonical semantic model is SysML v2 and KerML aligned. Existing Engineering Model concepts map into that model once; legacy YAML remains an input adapter during migration and must not create a parallel set of parts, interfaces, flows, requirements, allocations, or views.";
    }

    @EngineeringElement {
        sourceId = "REQ-EMG-036";
        conceptKind = "requirement_definition";
        payload = "{\"namespace\":\"engineering-model-go\",\"owner\":\"engineering-model-go\",\"features\":[{\"name\":\"text\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"Where sysml export is enabled, when generation run is requested, the engineering model go shall generate sysml v2 model artifact from canonical semantic model.\"}},{\"name\":\"notes\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"The exporter preserves stable identifiers and maps standard concepts to SysML v2 or KerML semantics. Engineering-specific security, compliance, repository, decision, and code-trace concepts remain typed extensions rather than duplicate standard concepts.\"}}],\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.requirement_source\",\"target\":\"REQ-EMG-036\",\"properties\":{\"AppliesTo\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"FU-SYSML-EXPORTER\"},{\"kind\":\"string\",\"string\":\"FU-CLI-ORCHESTRATION\"},{\"kind\":\"string\",\"string\":\"FU-VALIDATION-ENGINE\"}]},\"ID\":{\"kind\":\"string\",\"string\":\"REQ-EMG-036\"},\"Notes\":{\"kind\":\"string\",\"string\":\"The exporter preserves stable identifiers and maps standard concepts to SysML v2 or KerML semantics. Engineering-specific security, compliance, repository, decision, and code-trace concepts remain typed extensions rather than duplicate standard concepts.\"},\"Text\":{\"kind\":\"string\",\"string\":\"Where sysml export is enabled, when generation run is requested, the engineering model go shall generate sysml v2 model artifact from canonical semantic model.\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.requirement_source\"}";
    }
    requirement def 'REQ-EMG-036' {
        attribute 'text' : 'String' = "Where sysml export is enabled, when generation run is requested, the engineering model go shall generate sysml v2 model artifact from canonical semantic model.";
        attribute 'notes' : 'String' = "The exporter preserves stable identifiers and maps standard concepts to SysML v2 or KerML semantics. Engineering-specific security, compliance, repository, decision, and code-trace concepts remain typed extensions rather than duplicate standard concepts.";
    }

    @EngineeringElement {
        sourceId = "REQ-EMG-037";
        conceptKind = "requirement_definition";
