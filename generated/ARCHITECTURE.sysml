_source\",\"target\":\"REQ-EMG-016\",\"properties\":{\"AppliesTo\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"FU-SYSTEM-COMPOSITION\"},{\"kind\":\"string\",\"string\":\"FU-MODEL-LOADER\"}]},\"ID\":{\"kind\":\"string\",\"string\":\"REQ-EMG-016\"},\"Notes\":{\"kind\":\"string\",\"string\":\"Recursive system-of-systems composition; local subdirectory references, with external git repositories cloned into the .engmod cache (REQ-EMG-027, ADR-EMG-008, ADR-EMG-010).\"},\"Text\":{\"kind\":\"string\",\"string\":\"Where system composition is enabled, when generation run is requested, the engineering model go shall resolve the subsystem references declared by the parent system from local subdirectory paths.\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.requirement_source\"},{\"id\":\"REQ-EMG-017\",\"name\":\"REQ-EMG-017\",\"kind\":\"requirement_definition\",\"metaclass\":\"SysML::RequirementDefinition\",\"properties\":{\"declaredName\":{\"values\":[{\"kind\":\"string\",\"string\":\"REQ-EMG-017\"}]},\"elementId\":{\"values\":[{\"kind\":\"string\",\"string\":\"REQ-EMG-017\"}]},\"owner\":{\"values\":[{\"kind\":\"reference\",\"reference\":\"engineering-model-go\"}],\"derived\":true},\"owningNamespace\":{\"values\":[{\"kind\":\"reference\",\"reference\":\"engineering-model-go\"}],\"derived\":true}},\"namespace\":\"engineering-model-go\",\"owner\":\"engineering-model-go\",\"features\":[{\"name\":\"text\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"Where system composition is enabled, when generation run is requested, the engineering model go shall reject any subsystem reference that resolves outside the repository workspace boundary.\"}},{\"name\":\"notes\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"Downward-only references remain within the workspace; mirrors the MCP path-boundary guardrail.\"}}],\"metadata\":[{\"namespace\":\"engineering\",\