\":{\"kind\":\"string\",\"string\":\"TRLC Exporter Intent\"}}},\"communication\":{\"kind\":\"object\",\"object\":{\"Narrative\":{\"kind\":\"string\",\"string\":\"Produces package and requirement artifacts consumed by LOBSTER and checks.\"},\"Title\":{\"kind\":\"string\",\"string\":\"TRLC Exporter Communication\"}}},\"deployment\":{\"kind\":\"object\",\"object\":{\"Narrative\":{\"kind\":\"string\",\"string\":\"Executed through engtrlc in CI and local assurance workflows.\"},\"Title\":{\"kind\":\"string\",\"string\":\"TRLC Exporter Deployment\"}}},\"security\":{\"kind\":\"object\",\"object\":{\"Narrative\":{\"kind\":\"string\",\"string\":\"Enforces stable requirement IDs and deterministic formatting for downstream verification.\"},\"Title\":{\"kind\":\"string\",\"string\":\"TRLC Exporter Security\"}}},\"traceability\":{\"kind\":\"object\",\"object\":{\"Narrative\":{\"kind\":\"string\",\"string\":\"Serves as canonical requirement export for trace-chain continuity.\"},\"Title\":{\"kind\":\"string\",\"string\":\"TRLC Exporter Traceability\"}}}}}}},{\"kind\":\"object\",\"object\":{\"Group\":{\"kind\":\"string\",\"string\":\"FG-TRACEABILITY-COMPLIANCE\"},\"ID\":{\"kind\":\"string\",\"string\":\"FU-LOBSTER-EXPORTER\"},\"Views\":{\"kind\":\"object\",\"object\":{\"architecture_intent\":{\"kind\":\"object\",\"object\":{\"Narrative\":{\"kind\":\"string\",\"string\":\"Converts requirement and test link evidence into LOBSTER activity traces.\"},\"Title\":{\"kind\":\"string\",\"string\":\"LOBSTER Exporter Intent\"}}},\"communication\":{\"kind\":\"object\",\"object\":{\"Narrative\":{\"kind\":\"string\",\"string\":\"Integrates TRLC outputs and inferred verification links for report generation.\"},\"Title\":{\"kind\":\"string\",\"string\":\"LOBSTER Exporter Communication\"}}},\"deployment\":{\"kind\":\"object\",\"object\":{\"Narrative\":{\"kind\":\"string\",\"string\":\"Runs through englobster and report scripts in validation workflows.\"},\"Title\":{\"kind\":\"string\",\"string\":\"