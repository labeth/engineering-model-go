        payload = "{\"namespace\":\"engineering-model-go\",\"owner\":\"engineering-model-go\",\"features\":[{\"name\":\"text\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"While mcp server is enabled, when mcp tool call is received and catalog references resolve successfully, the engineering model go shall return model authoring contract.\"}},{\"name\":\"notes\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"The contract is compact machine-readable context containing resolved paths, effective schema versions, authoritative CUE schema locations, top-level YAML fields, stable-ID conventions, and recommended authoring order.\"}}],\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.requirement_source\",\"target\":\"REQ-EMG-045\",\"properties\":{\"AppliesTo\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"FU-MCP-SERVER\"},{\"kind\":\"string\",\"string\":\"FU-MODEL-LOADER\"}]},\"ID\":{\"kind\":\"string\",\"string\":\"REQ-EMG-045\"},\"Notes\":{\"kind\":\"string\",\"string\":\"The contract is compact machine-readable context containing resolved paths, effective schema versions, authoritative CUE schema locations, top-level YAML fields, stable-ID conventions, and recommended authoring order.\"},\"Text\":{\"kind\":\"string\",\"string\":\"While mcp server is enabled, when mcp tool call is received and catalog references resolve successfully, the engineering model go shall return model authoring contract.\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.requirement_source\"}";
    }
    requirement def 'REQ-EMG-045' {
        attribute 'text' : 'String' = "While mcp server is enabled, when mcp tool call is received and catalog references resolve successfully, the engineering model go shall return model authoring contract.";
        attribute 'notes' : 'String' = "The contract is compact machine-readable context containing resolved paths, effective schema versions, authoritative CUE schema locations, top-level YAML fields, stable-ID conventions, and recommended authoring order.";
    }

