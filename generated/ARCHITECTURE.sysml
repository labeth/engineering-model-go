    @EngineeringElement {
        sourceId = "REQ-EMG-010";
        conceptKind = "requirement_definition";
        payload = "{\"namespace\":\"engineering-model-go\",\"owner\":\"engineering-model-go\",\"features\":[{\"name\":\"text\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"Where requirement trace is complete, when model updated event is received, the engineering model go shall infer traceability coverage from trace markers.\"}},{\"name\":\"notes\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"Links runtime, code, and test markers to modeled requirement coverage. Code and metadata scanning excludes dependency caches (node_modules, vendor) and dot-directories (.git, .engmod, tool caches) so coverage reflects only committed first-party source and stays reproducible.\"}}],\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.requirement_source\",\"target\":\"REQ-EMG-010\",\"properties\":{\"AppliesTo\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"FU-CODEMAP-INFERENCE\"}]},\"ID\":{\"kind\":\"string\",\"string\":\"REQ-EMG-010\"},\"Notes\":{\"kind\":\"string\",\"string\":\"Links runtime, code, and test markers to modeled requirement coverage. Code and metadata scanning excludes dependency caches (node_modules, vendor) and dot-directories (.git, .engmod, tool caches) so coverage reflects only committed first-party source and stays reproducible.\"},\"Text\":{\"kind\":\"string\",\"string\":\"Where requirement trace is complete, when model updated event is received, the engineering model go shall infer traceability coverage from trace markers.\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.requirement_source\"}";
    }
    requirement def 'REQ-EMG-010' {
        attribute 'text' : 'String' = "Where requirement trace is complete, when model updated event is received, the engineering model go shall infer traceability coverage from trace markers.";
        attribute 'notes' : 'String' = "Links runtime, code, and test markers to modeled requirement coverage. Code and metadata scanning excludes dependency caches (node_modules, vendor) and dot-directories (.git, .engmod, tool caches) so coverage reflects only committed first-party source and stays reproducible.";
    }

    @EngineeringElement {
