"string\",\"string\":\"REQ-EMG-019\"},\"Notes\":{\"kind\":\"string\",\"string\":\"Identifiers are scoped per system; cross-system references are qualified by subsystem to avoid collisions.\"},\"Text\":{\"kind\":\"string\",\"string\":\"Where system composition is enabled, when generation run is requested, the engineering model go shall resolve cross-system references using subsystem-qualified identifiers.\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.requirement_source\"},{\"id\":\"REQ-EMG-020\",\"name\":\"REQ-EMG-020\",\"kind\":\"requirement_definition\",\"metaclass\":\"SysML::RequirementDefinition\",\"properties\":{\"declaredName\":{\"values\":[{\"kind\":\"string\",\"string\":\"REQ-EMG-020\"}]},\"elementId\":{\"values\":[{\"kind\":\"string\",\"string\":\"REQ-EMG-020\"}]},\"owner\":{\"values\":[{\"kind\":\"reference\",\"reference\":\"engineering-model-go\"}],\"derived\":true},\"owningNamespace\":{\"values\":[{\"kind\":\"reference\",\"reference\":\"engineering-model-go\"}],\"derived\":true}},\"namespace\":\"engineering-model-go\",\"owner\":\"engineering-model-go\",\"features\":[{\"name\":\"text\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"Where system composition is enabled, when generation run is requested, the engineering model go shall materialize parent-to-subsystem allocation traceability in the composed output without modifying any subsystem model.\"}},{\"name\":\"notes\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"A subsystem is parent-agnostic; parent allocation is materialized only in composed artifacts, never written back to the child (ADR-EMG-009, ADR-EMG-011).\"}}],\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.requirement_source\",\"target\":\"REQ-EMG-020\",\"properties\":{\"AppliesTo\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"FU-ALLOCATION-TRACE\"}]},\"ID\":{\"kind\":\"string\",\"string\":\"REQ-EMG-020\"},\"Notes\":{\"kind\":\"string\",\"string\":\"A subsystem is parent-agnostic; parent allocation is materialized only in composed artifacts, never written back to the child (ADR-EMG-009, ADR-EMG-011).\"},\"Text\":{\"kind\":\"string\",\"string\":\"Where system composition is enabled, when generation run is requested, the engineering model go shall materialize parent-to-subsystem allocation traceability in the composed output without modifying any subsystem model.\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.requirement_source\"},{\"id\":\"REQ-EMG-021\",\"name\":\"REQ-EMG-021\",\"kind\":\"requirement_definition\",\"metaclass\":\"SysML::RequirementDefinition\",\"properties\":{\"declaredName\":{\"values\":[{\"kind\":\"string\",\"string\":\"REQ-EMG-021\"}]},\"elementId\":{\"values\":[{\"kind\":\"string\",\"string\":\"REQ-EMG-021\"}]},\"owner\":{\"values\":[{\"kind\":\"reference\",\"reference\":\"engineering-model-go\"}],\"derived\":true},\"owningNamespace\":{\"values\":[{\"kind\":\"reference\",\"reference\":\"engineering-model-go\"}],\"derived\":true}},\"namespace\":\"engineering-model-go\",\"owner\":\"engineering-model-go\",\"features\":[{\"name\":\"text\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"Where system composition is enabled, when generation run is requested, the engineering model go shall report each subsystem required interface that the parent system does not satisfy.\"}},{\"name\":\"notes\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"Subsystems publish a provides-and-requires contract; the parent must satisfy each required interface.\"}}],\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.requirement_source\",\"target\":\"REQ-EMG-021\",\"properties\":{\"AppliesTo\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"FU-ALLOCATION-TRACE\"},{\"kind\":\"string\",\"string\":\"FU-VALIDATION-ENGINE\"}]},