        payload = "{\"namespace\":\"engineering-model-go\",\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.actor\",\"target\":\"ACT-ARCHITECTURE-AUTHOR\",\"properties\":{\"Description\":{\"kind\":\"string\",\"string\":\"Maintains modeled structure, mappings, and architecture intent.\"},\"ID\":{\"kind\":\"string\",\"string\":\"ACT-ARCHITECTURE-AUTHOR\"},\"Name\":{\"kind\":\"string\",\"string\":\"Architecture Author\"}}},{\"namespace\":\"engineering\",\"type\":\"engineering.catalog.actors\",\"target\":\"ACT-ARCHITECTURE-AUTHOR\",\"properties\":{\"Aliases\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"model author\"}]},\"Definition\":{\"kind\":\"string\",\"string\":\"Maintains model structure, mappings, and architecture intent.\"},\"ID\":{\"kind\":\"string\",\"string\":\"ACT-ARCHITECTURE-AUTHOR\"},\"Name\":{\"kind\":\"string\",\"string\":\"architecture author\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.actor\"}";
    }
    item def 'ACT-ARCHITECTURE-AUTHOR';

    @EngineeringElement {
        sourceId = "ACT-CI-PIPELINE";
        conceptKind = "stakeholder_definition";
        payload = "{\"namespace\":\"engineering-model-go\",\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.actor\",\"target\":\"ACT-CI-PIPELINE\",\"properties\":{\"Description\":{\"kind\":\"string\",\"string\":\"Executes regression tests, validation checks, and artifact generation.\"},\"ID\":{\"kind\":\"string\",\"string\":\"ACT-CI-PIPELINE\"},\"Name\":{\"kind\":\"string\",\"string\":\"CI Pipeline\"}}},{\"namespace\":\"engineering\",\"type\":\"engineering.catalog.actors\",\"target\":\"ACT-CI-PIPELINE\",\"properties\":{\"Aliases\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"ci\"}]},\"Definition\":{\"kind\":\"string\",\"string\":\"Runs automated validation and export checks for pull requests.\"},\"ID\":{\"kind\":\"string\",\"string\":\"ACT-CI-PIPELINE\"},\"Name\":{\"kind\":\"string\",\"string\":\"ci pipeline\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.actor\"}";
    }
    item def 'ACT-CI-PIPELINE';

    @EngineeringElement {
        sourceId = "ACT-COMPLIANCE-ENGINEER";
        conceptKind = "stakeholder_definition";
        payload = "{\"namespace\":\"engineering-model-go\",\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.actor\",\"target\":\"ACT-COMPLIANCE-ENGINEER\",\"properties\":{\"Description\":{\"kind\":\"string\",\"string\":\"Uses control/risk and traceability outputs for assurance workflows.\"},\"ID\":{\"kind\":\"string\",\"string\":\"ACT-COMPLIANCE-ENGINEER\"},\"Name\":{\"kind\":\"string\",\"string\":\"Compliance Engineer\"}}},{\"namespace\":\"engineering\",\"type\":\"engineering.catalog.actors\",\"target\":\"ACT-COMPLIANCE-ENGINEER\",\"properties\":{\"Aliases\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"assurance\"}]},\"Definition\":{\"kind\":\"string\",\"string\":\"Reviews controls, risks, and traceability outputs for compliance needs.\"},\"ID\":{\"kind\":\"string\",\"string\":\"ACT-COMPLIANCE-ENGINEER\"},\"Name\":{\"kind\":\"string\",\"string\":\"compliance engineer\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.actor\"}";
    }
    item def 'ACT-COMPLIANCE-ENGINEER';

    @EngineeringElement {
        sourceId = "ACT-IMPLEMENTATION-ENGINEER";
        conceptKind = "stakeholder_definition";
        payload = "{\"namespace\":\"engineering-model-go\",\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.actor\",\"target\":\"ACT-IMPLEMENTATION-ENGINEER\",\"properties\":{\"Description\":{\"kind\":\"string\",\"string\":\"Implements code and tests guided by requirement support paths.\"},\"ID\":{\"kind\":\"string\",\"string\":\"ACT-IMPLEMENTATION-ENGINEER\"},\"Name\":{\"kind\":\"string\",\"string\":\"Implementation Engineer\"}}},{\"namespace\":\"engineering\",\"type\":\"engineering.catalog.actors\",\"target\":\"ACT-IMPLEMENTATION-ENGINEER\",\"properties\":{\"Aliases\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"engineer\"}]},\"Definition\":{\"kind\":\"string\",\"string\":\"Implements code changes guided by model requirements and support paths.\"},\"ID\":{\"kind\":\"string\",\"string\":\"ACT-IMPLEMENTATION-ENGINEER\"},\"Name\":{\"kind\":\"string\",\"string\":\"implementation engineer\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.actor\"}";
    }
    item def 'ACT-IMPLEMENTATION-ENGINEER';

    @EngineeringElement {
        sourceId = "ADR-EMG-001";
        conceptKind = "engineering_extension";
        payload = "{\"namespace\":\"engineering-model-go\",\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.architecture_decision\",\"target\":\"ADR-EMG-001\",\"properties\":{\"Consequences\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"The main architecture document remains focused on current architecture and traceability.\"},{\"kind\":\"string\",\"string\":\"Decision rationale remains reviewable as structured model content.\"},{\"kind\":\"string\",\"string\":\"Generation workflows need a separate decisions output alongside the main AsciiDoc output.\"}]},\"Context\":{\"kind\":\"string\",\"string\":\"Architecture decision records explain why durable model and generator choices were made.\\nThe main architecture publication should stay focused on the current structure, views,\\nand evidence instead of embedding the full decision history inline.\\n\"},\"Date\":{\"kind\":\"string\",\"string\":\"2026-04-29\"},\"Decision\":{\"kind\":\"string\",\"string\":\"Model architecture decision records as first-class authored data and generate them into\\na separate Architecture Decision Records document. The main architecture document links\\nto the generated decision records document through a compact decision index.\\n\"},\"ID\":{\"kind\":\"string\",\"string\":\"ADR-EMG-001\"},\"Status\":{\"kind\":\"string\",\"string\":\"accepted\"},\"Title\":{\"kind\":\"string\",\"string\":\"Generate architecture decision records separately from the main architecture document\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.architecture_decision\",\"targets\":[\"engineering-model-go\"]}";
    }
    attribute 'ADR-EMG-001';

    @EngineeringElement {
        sourceId = "ADR-EMG-002";
        conceptKind = "engineering_extension";
        payload = "{\"namespace\":\"engineering-model-go\",\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.architecture_decision\",\"target\":\"ADR-EMG-002\",\"properties\":{\"Consequences\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"ADRs remain focused on architectural rationale instead of implementation inventory.\"},{\"kind\":\"string\",\"string\":\"Code traceability continues to use requirement and owner markers.\"},{\"kind\":\"string\",\"string\":\"Main architecture outputs can link to ADRs without embedding code-level decision links.\"}]},\"Context\":{\"kind\":\"string\",\"string\":\"Architecture decision records capture durable reasoning about model and generator choices.\\nLinking decisions directly to implementation files would create noisy trace paths and imply\\ncode-level ownership that decisions are not meant to carry.\\n\"},\"Date\":{\"kind\":\"string\",\"string\":\"2026-04-29\"},\"Decision\":{\"kind\":\"string\",\"string\":\"Store architecture decision records as first-class authored model data with required context,\\ndecision, status, date, and consequences. Do not add code-link fields to the ADR model.\\n\"},\"ID\":{\"kind\":\"string\",\"string\":\"ADR-EMG-002\"},\"Status\":{\"kind\":\"string\",\"string\":\"accepted\"},\"Title\":{\"kind\":\"string\",\"string\":\"Keep architecture decision records model-authored and separate from code links\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.architecture_decision\",\"targets\":[\"engineering-model-go\"]}";
    }
    attribute 'ADR-EMG-002';

    @EngineeringElement {
        sourceId = "ADR-EMG-003";
        conceptKind = "engineering_extension";
        payload = "{\"namespace\":\"engineering-model-go\",\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.architecture_decision\",\"target\":\"ADR-EMG-003\",\"properties\":{\"Consequences\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"Output is guaranteed to match the Gemara schemas and is consumable by other Gemara tooling.\"},{\"kind\":\"string\",\"string\":\"engmod takes a dependency on go-gemara (and transitively go-oscal) for the export path.\"},{\"kind\":\"string\",\"string\":\"The L5 evaluation log validates via the schema and SDK type discriminator but is not round-tripped through the SDK loader, because its AssessmentStep is a func type that serializes to a name string yet cannot be unmarshaled back.\"}]},\"Context\":{\"kind\":\"string\",\"string\":\"OpenSSF Gemara is a layered GRC engineering model with published CUE schemas and a Go SDK.\\nThe engineering model already captures controls, threats, risks, attack vectors, functional\\nunits, verification evidence, and POA\\u0026M items, which align with Gemara's L1-L3 catalogs, the L5\\nevaluation log, the L6 enforcement log, and the L7 audit log. We needed a way to emit Gemara that\\nis guaranteed structurally correct rather than a hand-written approximation.\\n\"},\"Date\":{\"kind\":\"string\",\"string\":\"2026-06-27\"},\"Decision\":{\"kind\":\"string\",\"string\":\"Build Gemara documents from the official go-gemara SDK structs (github.com/gemaraproj/go-gemara)\\nand serialize them with the same YAML codec the SDK uses. Treat Gemara as a first-class rendering\\nwith a library API, an enggemara CLI, an AsciiDoc chapter, and MCP tools. Validate every artifact\\ntwo ways: load it back through the SDK loader/type discriminator in tests, and run cue vet against\\nthe published Gemara schemas.\\n\"},\"ID\":{\"kind\":\"string\",\"string\":\"ADR-EMG-003\"},\"Status\":{\"kind\":\"string\",\"string\":\"accepted\"},\"Title\":{\"kind\":\"string\",\"string\":\"Render Gemara as a first-class output using the official go-gemara SDK types\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.architecture_decision\",\"targets\":[\"engineering-model-go\"]}";
    }
    attribute 'ADR-EMG-003';

    @EngineeringElement {
        sourceId = "ADR-EMG-004";
        conceptKind = "engineering_extension";
        payload = "{\"namespace\":\"engineering-model-go\",\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.architecture_decision\",\"target\":\"ADR-EMG-004\",\"properties\":{\"Consequences\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"The evaluation log faithfully represents pass and fail outcomes rather than failures only.\"},{\"kind\":\"string\",\"string\":\"Inferred-from-tests verification can later augment this source without changing the contract.\"}]},\"Context\":{\"kind\":\"string\",\"string\":\"A Gemara L5 evaluation log is meant to carry the opinionated result of assessing each control,\\nincluding passing assessments. The existing OSCAL assessment results path intentionally records\\nonly non-passing findings, so it is a lossy source for an evaluation log.\\n\"},\"Date\":{\"kind\":\"string\",\"string\":\"2026-06-27\"},\"Decision\":{\"kind\":\"string\",\"string\":\"Build the evaluation log from authored control verifications, which carry both pass and fail\\nstatuses, mapping each verification to an assessment log under its control's evaluation. Synthesize\\na needs-review assessment for controls that have no authored verification.\\n\"},\"ID\":{\"kind\":\"string\",\"string\":\"ADR-EMG-004\"},\"Status\":{\"kind\":\"string\",\"string\":\"accepted\"},\"Title\":{\"kind\":\"string\",\"string\":\"Source the Gemara evaluation log from authored control verifications, with pass and fail outcomes\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.architecture_decision\",\"targets\":[\"engineering-model-go\"]}";
    }
    attribute 'ADR-EMG-004';

    @EngineeringElement {
        sourceId = "ADR-EMG-005";
        conceptKind = "engineering_extension";
        payload = "{\"namespace\":\"engineering-model-go\",\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.architecture_decision\",\"target\":\"ADR-EMG-005\",\"properties\":{\"Consequences\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"No information is lost; the same compliance problems remain solved by the existing OSCAL outputs.\"},{\"kind\":\"string\",\"string\":\"A new Gemara-sourced OSCAL control catalog becomes available for catalog-centric workflows.\"},{\"kind\":\"string\",\"string\":\"There are now two OSCAL assessment-results paths; the engmod-native one stays authoritative.\"}]},\"Context\":{\"kind\":\"string\",\"string\":\"The go-gemara SDK converts a Gemara control catalog to an OSCAL Catalog and a Gemara evaluation log\\nto OSCAL Assessment Results. It does not produce an OSCAL System Security Plan or Plan of Action and\\nMilestones, and it does not carry system characteristics, POA\\u0026M items, or compliance-profile-resolved\\nreviewed controls with engmod's deterministic UUID scheme.\\n\"},\"Date\":{\"kind\":\"string\",\"string\":\"2026-06-27\"},\"Decision\":{\"kind\":\"string\",\"string\":\"Retain engmod's hand-written OSCAL SSP, Assessment Results, and POA\\u0026M exporters unchanged. Expose the\\nGemara-to-OSCAL conversion as an additive option on enggemara, emitting a Gemara-sourced OSCAL control\\ncatalog (which engmod did not previously produce) and OSCAL assessment results.\\n\"},\"ID\":{\"kind\":\"string\",\"string\":\"ADR-EMG-005\"},\"Status\":{\"kind\":\"string\",\"string\":\"accepted\"},\"Title\":{\"kind\":\"string\",\"string\":\"Keep hand-written OSCAL SSP/AR/POA\\u0026M; add Gemara-to-OSCAL only as an additive bridge\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.architecture_decision\",\"targets\":[\"engineering-model-go\"]}";
    }
    attribute 'ADR-EMG-005';

    @EngineeringElement {
        sourceId = "ADR-EMG-006";
        conceptKind = "engineering_extension";
        payload = "{\"namespace\":\"engineering-model-go\",\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.architecture_decision\",\"target\":\"ADR-EMG-006\",\"properties\":{\"Consequences\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"Every artifact is schema-valid without requiring intrusive changes to the authored model.\"},{\"kind\":\"string\",\"string\":\"Risk appetite and applicability remain coarse until authored as first-class model inputs.\"},{\"kind\":\"string\",\"string\":\"A future model reshape can replace synthesized fields with authored ones without changing the export.\"}]},\"Context\":{\"kind\":\"string\",\"string\":\"Several Gemara constructs are required by the schemas but are not first-class in the engineering\\nmodel: per-control assessment requirements and applicability groups, threat capability references,\\nand risk severity, category, and appetite. Some of these are organizational inputs that cannot be\\ninferred from the technical model.\\n\"},\"Date\":{\"kind\":\"string\",\"string\":\"2026-06-27\"},\"Decision\":{\"kind\":\"string\",\"string\":\"Synthesize the missing structure deterministically: assessment requirements from control\\nverifications (or a default requirement); applicability groups from functional units plus an\\nall-systems catch-all; threat capabilities from appliesTo with a synthetic system capability\\nfallback; risk severity derived from likelihood and impact; and a default risk category carrying an\\nauthored appetite. Keep generated artifacts reproducible by stamping dates only from an explicit option.\\n\"},\"ID\":{\"kind\":\"string\",\"string\":\"ADR-EMG-006\"},\"Status\":{\"kind\":\"string\",\"string\":\"accepted\"},\"Title\":{\"kind\":\"string\",\"string\":\"Synthesize Gemara structure that the model does not author, with explicit fallbacks\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.architecture_decision\",\"targets\":[\"engineering-model-go\"]}";
    }
    attribute 'ADR-EMG-006';

    @EngineeringElement {
        sourceId = "ADR-EMG-007";
        conceptKind = "engineering_extension";
        payload = "{\"namespace\":\"engineering-model-go\",\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.architecture_decision\",\"target\":\"ADR-EMG-007\",\"properties\":{\"Consequences\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"Existing var/const markers now link to the model, giving full linking and a warning-free scan.\"},{\"kind\":\"string\",\"string\":\"Functions and methods remain the only declarations that must carry a TRLC-LINKS marker.\"},{\"kind\":\"string\",\"string\":\"The scanner policy test was updated to detect stray markers via a non-declaration position.\"}]},\"Context\":{\"kind\":\"string\",\"string\":\"The Go code scanner originally treated only functions, methods, and types as declaration-level\\ntrace targets. Markers placed before package-level var and const declarations (for example template\\nand pattern variables) did not attach and were reported as trace_unattached warnings, so their\\nlinking intent was lost and the repository could not reach a fully clean strict-linking scan.\\n\"},\"Date\":{\"kind\":\"string\",\"string\":\"2026-06-27\"},\"Decision\":{\"kind\":\"string\",\"string\":\"Treat package-level var and const declarations as declaration kinds that attach TRLC-LINKS and\\nENGMODEL-LINKS markers, while keeping only functions and methods trace-required. Stray markers that\\nprecede no declaration (for example a trailing marker at end of file) are still reported as unattached.\\n\"},\"ID\":{\"kind\":\"string\",\"string\":\"ADR-EMG-007\"},\"Status\":{\"kind\":\"string\",\"string\":\"accepted\"},\"Title\":{\"kind\":\"string\",\"string\":\"Attach trace and model-link markers to package-level var and const declarations\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.architecture_decision\",\"targets\":[\"engineering-model-go\"]}";
    }
    attribute 'ADR-EMG-007';

    @EngineeringElement {
        sourceId = "ADR-EMG-008";
        conceptKind = "engineering_extension";
        payload = "{\"namespace\":\"engineering-model-go\",\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.architecture_decision\",\"target\":\"ADR-EMG-008\",\"properties\":{\"Consequences\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"One model shape composes at every level; existing single-model projects are simply leaf systems.\"},{\"kind\":\"string\",\"string\":\"Requirement flow-down across systems mirrors ARP4754A allocation.\"},{\"kind\":\"string\",\"string\":\"Composition is additive and backward compatible with existing models.\"}]},\"Context\":{\"kind\":\"string\",\"string\":\"DO-178C governs software only; the hardware and software platforms and their connections are\\nallocated at the system level (ARP4754A) above the software (DO-178C) and hardware (DO-254)\\nprocesses. The engineering model needs to represent system requirements, architecture, hardware,\\nand the hardware/software interface, and to compose software components that may live in\\nsubdirectories or in separate repositories.\\n\"},\"Date\":{\"kind\":\"string\",\"string\":\"2026-06-27\"},\"Decision\":{\"kind\":\"string\",\"string\":\"Treat every model uniformly as a system. A system may reference and allocate to subsystem models,\\nwhich are themselves systems, recursively to any depth. Software and hardware items are leaf systems\\nwhere the DO-178C and DO-254 lifecycle data attaches. There are no fixed system/software/hardware tiers.\\n\"},\"ID\":{\"kind\":\"string\",\"string\":\"ADR-EMG-008\"},\"Status\":{\"kind\":\"string\",\"string\":\"accepted\"},\"Title\":{\"kind\":\"string\",\"string\":\"Model multi-repository work as a recursive system-of-systems\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.architecture_decision\",\"targets\":[\"engineering-model-go\"]}";
    }
    attribute 'ADR-EMG-008';

    @EngineeringElement {
        sourceId = "ADR-EMG-009";
        conceptKind = "engineering_extension";
        payload = "{\"namespace\":\"engineering-model-go\",\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.architecture_decision\",\"target\":\"ADR-EMG-009\",\"properties\":{\"Consequences\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"Subsystem repositories are reusable and parent-agnostic.\"},{\"kind\":\"string\",\"string\":\"The reference graph is a parent-to-child directed acyclic graph; cycles are rejected.\"},{\"kind\":\"string\",\"string\":\"Validation has a standalone scope (the subsystem alone) and a composed scope (the bindings).\"}]},\"Context\":{\"kind\":\"string\",\"string\":\"A subsystem may be reused under many different parent systems and must not depend on any of them.\\nAllocation and binding must live where the integration happens.\\n\"},\"Date\":{\"kind\":\"string\",\"string\":\"2026-06-27\"},\"Decision\":{\"kind\":\"string\",\"string\":\"A subsystem never references or is aware of its parents. A parent system declares which subsystems it\\nuses and how it allocates its requirements onto them. Subsystems expose a provides-and-requires\\ncontract with a public surface distinct from internal identifiers; parents bind only to the public\\ncontract and must satisfy each required interface.\\n\"},\"ID\":{\"kind\":\"string\",\"string\":\"ADR-EMG-009\"},\"Status\":{\"kind\":\"string\",\"string\":\"accepted\"},\"Title\":{\"kind\":\"string\",\"string\":\"Subsystem references are downward-only with parent-owned allocation\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.architecture_decision\",\"targets\":[\"engineering-model-go\"]}";
    }
    attribute 'ADR-EMG-009';

    @EngineeringElement {
        sourceId = "ADR-EMG-010";
        conceptKind = "engineering_extension";
        payload = "{\"namespace\":\"engineering-model-go\",\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.architecture_decision\",\"target\":\"ADR-EMG-010\",\"properties\":{\"Consequences\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"The same resolver serves a monorepo and multi-repository layouts.\"},{\"kind\":\"string\",\"string\":\"Composed snapshots are reproducible; pin a revision for an exact one.\"},{\"kind\":\"string\",\"string\":\"Air-gapped certification environments remain supported once the .engmod cache is populated.\"}]},\"Context\":{\"kind\":\"string\",\"string\":\"Composition should be proven within a single repository before adding cross-repository plumbing, and\\ncertification evidence must be reproducible and resolvable offline.\\n\"},\"Date\":{\"kind\":\"string\",\"string\":\"2026-06-27\"},\"Decision\":{\"kind\":\"string\",\"string\":\"The reference resolver supports local subdirectory paths and external git repositories. A git\\nsubsystem is cloned once into the workspace .engmod cache (gitignored, treated as temporary), pinned to\\nan optional revision, and then resolved exactly like a local subsystem; an existing clone that points\\nat the same repository is reused without network access, so a build is offline-reproducible after the\\nfirst resolve.\\n\"},\"ID\":{\"kind\":\"string\",\"string\":\"ADR-EMG-010\"},\"Status\":{\"kind\":\"string\",\"string\":\"accepted\"},\"Title\":{\"kind\":\"string\",\"string\":\"Resolve subsystem references from local subdirectories first\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.architecture_decision\",\"targets\":[\"engineering-model-go\"]}";
    }
    attribute 'ADR-EMG-010';

    @EngineeringElement {
        sourceId = "ADR-EMG-011";
        conceptKind = "engineering_extension";
        payload = "{\"namespace\":\"engineering-model-go\",\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.architecture_decision\",\"target\":\"ADR-EMG-011\",\"properties\":{\"Consequences\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"Requirement documents stay flat and boundary-agnostic.\"},{\"kind\":\"string\",\"string\":\"Delegation is expressed once, by the integrating system's downward allocation.\"},{\"kind\":\"string\",\"string\":\"Internal requirement-to-requirement links are reported instead of silently accepted.\"}]},\"Context\":{\"kind\":\"string\",\"string\":\"Requirement levels (system, high-level, low-level) are confusing across a system boundary: a parent\\nsystem's low-level requirement would point at a subsystem's system-level requirement, mixing tier\\nmeanings between two models. The link itself already says whether a requirement is delegated.\\n\"},\"Date\":{\"kind\":\"string\",\"string\":\"2026-06-27\"},\"Decision\":{\"kind\":\"string\",\"string\":\"Requirements carry no tiers. A requirement is either delegated to a subsystem through a downward\\ncomposition allocation or implemented here; the presence or absence of a delegation link is enough to\\ntell the two apart. Linking one requirement to another inside the same document is flagged, because it\\nrecreates the tier coupling this decision removes.\\n\"},\"ID\":{\"kind\":\"string\",\"string\":\"ADR-EMG-011\"},\"Status\":{\"kind\":\"string\",\"string\":\"accepted\"},\"Title\":{\"kind\":\"string\",\"string\":\"Requirements carry no tiers; delegation is the link\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.architecture_decision\",\"targets\":[\"engineering-model-go\"]}";
    }
    attribute 'ADR-EMG-011';

    @EngineeringElement {
        sourceId = "ADR-EMG-012";
        conceptKind = "engineering_extension";
        payload = "{\"namespace\":\"engineering-model-go\",\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.architecture_decision\",\"target\":\"ADR-EMG-012\",\"properties\":{\"Consequences\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"Trace links are trustworthy, not merely well-formed; the matrix is a real artifact, not prose.\"},{\"kind\":\"string\",\"string\":\"Monorepos with multiple models validate cleanly without cross-model false positives.\"},{\"kind\":\"string\",\"string\":\"Orphan coverage gaps are visible without breaking the build.\"}]},\"Context\":{\"kind\":\"string\",\"string\":\"Code trace markers (TRLC-LINKS to a requirement, ENGMODEL-LINKS to a model element) were only\\nshape-checked by a regex, so a link to a deleted or mistyped id passed silently. In a monorepo the code\\nroot can also contain other models' code (each example carries its own architecture.yml), whose markers\\nreference their own requirements, not the model being generated.\\n\"},\"Date\":{\"kind\":\"string\",\"string\":\"2026-06-27\"},\"Decision\":{\"kind\":\"string\",\"string\":\"Every code trace link is existence-checked against the model: a dangling requirement or model-element\\nlink is an error, and a requirement traced by no code, verification, or delegation is reported as an\\norphan warning. Code is attributed to the model whose architecture.yml is its nearest enclosing root,\\nso a parent model never validates or counts a child model's links. The consolidated trace is also\\nemitted as a machine-readable matrix (req to code, verification, and delegated subsystem requirement).\\n\"},\"ID\":{\"kind\":\"string\",\"string\":\"ADR-EMG-012\"},\"Status\":{\"kind\":\"string\",\"string\":\"accepted\"},\"Title\":{\"kind\":\"string\",\"string\":\"Trace links are existence-checked, scoped to the owning model, and exported as a matrix\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.architecture_decision\",\"targets\":[\"engineering-model-go\"]}";
    }
    attribute 'ADR-EMG-012';

    @EngineeringElement {
        sourceId = "ADR-EMG-013";
        conceptKind = "engineering_extension";
        payload = "{\"namespace\":\"engineering-model-go\",\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.architecture_decision\",\"target\":\"ADR-EMG-013\",\"properties\":{\"Consequences\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"The generation gates are load-bearing: a broken model or a stale committed document fails CI.\"},{\"kind\":\"string\",\"string\":\"Generated artifacts are deterministic and reproducible from the model.\"},{\"kind\":\"string\",\"string\":\"One script is the source of truth for local pre-commit checks and CI.\"}]},\"Context\":{\"kind\":\"string\",\"string\":\"The tool's gates — engdoc errors, trace-link integrity, EARS lint, composition checks, and Gemara\\nschema validity — and its committed generated artifacts only have value if they are enforced. CI\\npreviously ran gofmt, vet, and unit tests only, so a model edit that broke generation or left the\\ncommitted documents stale could merge green. Enforcing artifact freshness also requires generation to\\nbe deterministic.\\n\"},\"Date\":{\"kind\":\"string\",\"string\":\"2026-06-28\"},\"Decision\":{\"kind\":\"string\",\"string\":\"A single gauntlet (scripts/validate-all.sh) runs in CI and locally. It regenerates every model's\\ndocuments — engdoc must exit clean, which enforces trace integrity, dangling links, EARS, and\\ncomposition — exports each trace matrix with engtrace (no dangling links), fails on any drift between\\nregenerated and committed artifacts, and validates the Gemara and Structurizr exports against their\\nschemas when the tools are present. Inline term linking was made deterministic so the drift check is\\nstable.\\n\"},\"ID\":{\"kind\":\"string\",\"string\":\"ADR-EMG-013\"},\"Status\":{\"kind\":\"string\",\"string\":\"accepted\"},\"Title\":{\"kind\":\"string\",\"string\":\"CI enforces the generation gates and artifact freshness\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.architecture_decision\",\"targets\":[\"engineering-model-go\"]}";
    }
    attribute 'ADR-EMG-013';

    @EngineeringElement {
        sourceId = "ADR-EMG-014";
        conceptKind = "engineering_extension";
        payload = "{\"namespace\":\"engineering-model-go\",\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.architecture_decision\",\"target\":\"ADR-EMG-014\",\"properties\":{\"Consequences\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"Change diffs stay focused on intended entities instead of reformatting the complete document.\"},{\"kind\":\"string\",\"string\":\"Existing model validation remains the authority for candidate correctness.\"},{\"kind\":\"string\",\"string\":\"Updates replace complete requirement entities rather than applying ambiguous field-level patches.\"},{\"kind\":\"string\",\"string\":\"The first schema version mutates requirements only.\"}]},\"Context\":{\"kind\":\"string\",\"string\":\"Local change workflows need deterministic add, update, and remove operations without making\\nagents rewrite complete model documents. Marshaling the typed Go structs would rewrite unrelated\\nYAML, drop comments, and emit zero-value fields, while text patches would bypass model semantics.\\n\"},\"Date\":{\"kind\":\"string\",\"string\":\"2026-09-15\"},\"Decision\":{\"kind\":\"string\",\"string\":\"Apply stable-ID operations to yaml.Node trees, preserving unchanged nodes and comments. Decode the\\nmerged candidate into the existing typed model and run the existing structural and EARS validators\\nbefore permitting an atomic same-directory replacement. Begin with requirements.yml and whole-entity\\nupdates; extend the same contract to other authored documents after the vertical slice is proven.\\n\"},\"ID\":{\"kind\":\"string\",\"string\":\"ADR-EMG-014\"},\"Status\":{\"kind\":\"string\",\"string\":\"accepted\"},\"Title\":{\"kind\":\"string\",\"string\":\"Apply model deltas through YAML nodes and typed candidate validation\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.architecture_decision\",\"targets\":[\"engineering-model-go\"]}";
    }
    attribute 'ADR-EMG-014';

    @EngineeringElement {
        sourceId = "ADR-EMG-015";
        conceptKind = "engineering_extension";
        payload = "{\"namespace\":\"engineering-model-go\",\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.architecture_decision\",\"target\":\"ADR-EMG-015\",\"properties\":{\"Consequences\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"YAML remains the authored source of truth, but its schema may change as the canonical semantic model matures.\"},{\"kind\":\"string\",\"string\":\"SysML textual syntax and project interchange remain generated outputs.\"},{\"kind\":\"string\",\"string\":\"Existing document, assurance, traceability, and validation behavior must be preserved through adapters.\"},{\"kind\":\"string\",\"string\":\"Exporters migrate to one canonical model instead of maintaining format-specific source models.\"},{\"kind\":\"string\",\"string\":\"SysML conformance claims are evidence-based and distinguish subset export from semantic-superset coverage.\"}]},\"Context\":{\"kind\":\"string\",\"string\":\"A parallel SysML export schema would duplicate parts, interfaces, flows, requirements, allocations,\\nand views already authored in the Engineering Model. It would allow the two representations to drift\\nand still would not establish SysML abstract-syntax or semantic conformance.\\n\"},\"Date\":{\"kind\":\"string\",\"string\":\"2026-09-18\"},\"Decision\":{\"kind\":\"string\",\"string\":\"Keep YAML as the canonical authoring and persistence format, while evolving its schema and the typed\\nin-memory model toward the SysML v2 and KerML abstract syntax. The current YAML schema may be accepted\\nthrough a migration adapter, but it is not a second semantic authority. SysML textual syntax is an\\noutput, not the canonical input. Every standard concept has one canonical representation shared by\\nvalidation and all exporters. Threat, compliance, risk, POA\\u0026M, ADR,\\nrepository-composition, code-ownership, and verification-evidence concepts remain typed extensions.\\nThe SysML exporter must report unsupported or lossy mappings and must not claim semantic-superset\\nconformance until executable coverage and round-trip checks cover the normative language.\\n\"},\"ID\":{\"kind\":\"string\",\"string\":\"ADR-EMG-015\"},\"Status\":{\"kind\":\"string\",\"string\":\"accepted\"},\"Title\":{\"kind\":\"string\",\"string\":\"Make SysML and KerML semantics canonical without duplicating Engineering Model concepts\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.architecture_decision\",\"targets\":[\"engineering-model-go\"]}";
    }
    attribute 'ADR-EMG-015';

    @EngineeringElement {
        sourceId = "ADR-EMG-016";
        conceptKind = "engineering_extension";
        payload = "{\"namespace\":\"engineering-model-go\",\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.architecture_decision\",\"target\":\"ADR-EMG-016\",\"properties\":{\"Consequences\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"Existing YAML authoring workflows and repositories remain compatible.\"},{\"kind\":\"string\",\"string\":\"CUE validation provides closed schemas, path-aware diagnostics, and cross-field constraints before runtime decoding.\"},{\"kind\":\"string\",\"string\":\"Tests must fail when CUE document shapes and Go YAML representations drift.\"},{\"kind\":\"string\",\"string\":\"Schema changes require coordinated CUE, runtime API, fixture, and documentation updates.\"},{\"kind\":\"string\",\"string\":\"SysML textual DSL remains a projection and cannot become an alternate source of truth.\"}]},\"Context\":{\"kind\":\"string\",\"string\":\"The canonical model needs one maintainable constraint language that rejects unknown fields,\\nexpresses cross-field invariants, and detects drift in runtime representations. Replacing YAML\\nauthoring with a CUE-authored domain model would create a second persistence format and disrupt\\nexisting repositories, while treating Go structs as the schema authority would limit declarative\\nconstraints and external schema reuse.\\n\"},\"Date\":{\"kind\":\"string\",\"string\":\"2026-09-18\"},\"Decision\":{\"kind\":\"string\",\"string\":\"Keep YAML instances as the canonical authored and persisted model. Use embedded, modular CUE schemas\\nas the authoritative shape and cross-field constraint contract for every canonical YAML document.\\nValidate YAML against CUE before strict Go decoding. Treat Go types as runtime API representations\\nwhose YAML fields are checked against the CUE contract, not as a separately authored semantic model.\\nDo not create a CUE-authored domain instance model. Keep SysML textual DSL as generated output from\\nthe normalized canonical model.\\n\"},\"ID\":{\"kind\":\"string\",\"string\":\"ADR-EMG-016\"},\"Status\":{\"kind\":\"string\",\"string\":\"accepted\"},\"Title\":{\"kind\":\"string\",\"string\":\"Use CUE as the schema contract for canonical YAML\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.architecture_decision\",\"targets\":[\"engineering-model-go\"]}";
    }
    attribute 'ADR-EMG-016';

    @EngineeringElement {
        sourceId = "ADR-EMG-017";
        conceptKind = "engineering_extension";
        payload = "{\"namespace\":\"engineering-model-go\",\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.architecture_decision\",\"target\":\"ADR-EMG-017\",\"properties\":{\"Consequences\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"CI blocks syntax errors, unsupported or lossy diagnostics, stale generated SysML, KPAR reopen failures, and semantic round-trip differences.\"},{\"kind\":\"string\",\"string\":\"KPAR files are produced by Sysand and are not custom archives presented as normative interchange.\"},{\"kind\":\"string\",\"string\":\"Local validation may be explicitly skipped when external tools are deliberately unavailable, while CI must install and run the pinned toolchain.\"},{\"kind\":\"string\",\"string\":\"Official parser success proves syntax against the selected baseline but does not by itself imply complete semantic conformance.\"}]},\"Context\":{\"kind\":\"string\",\"string\":\"SysML project interchange must be externally consumable and its conformance claims must be\\nreproducible in CI. A hand-built ZIP cannot establish KerML KPAR conformance, an unpinned\\ninstaller cannot provide repeatable evidence, and the 2026-08 Pilot Implementation targets\\nSysML 2.1 Beta 2 rather than the formal SysML 2.0 and KerML 1.0 baseline.\\n\"},\"Date\":{\"kind\":\"string\",\"string\":\"2026-09-18\"},\"Decision\":{\"kind\":\"string\",\"string\":\"Validate generated source with the official Pilot Implementation release 2026-04, artifact\\n0.59.0, commit 20897e3122f2c2f8b29389745f0caaaeb7c6e21a, through the\\nDeciSym/sysmlv2-validator wrapper pinned at commit\\n63abbd9fbc7851dc437d01b2dc07836b919770b8 and configured with the matching\\nrelease tag and artifact version. Delegate project creation, KPAR packaging, and KPAR reopen\\nto Sysand 0.2.1 at commit 8430ab04d4d825fb1c196670692d2dafa344e713.\\nCache all tools under the ignored .engmod tree, verify published release-asset SHA-256\\ndigests, and use immutable Git commits where no separate source-archive checksum is\\npublished. Preserve the canonical semantic model in typed EngineeringProject metadata and\\nrequire reconstructed semantic equivalence after reopening the KPAR.\\n\"},\"ID\":{\"kind\":\"string\",\"string\":\"ADR-EMG-017\"},\"Status\":{\"kind\":\"string\",\"string\":\"accepted\"},\"Title\":{\"kind\":\"string\",\"string\":\"Pin the official SysML 2.0 parser baseline and delegate KPAR packaging to Sysand\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.architecture_decision\",\"targets\":[\"engineering-model-go\"]}";
    }
    attribute 'ADR-EMG-017';

    @EngineeringElement {
        sourceId = "ADR-EMG-018";
        conceptKind = "engineering_extension";
        payload = "{\"namespace\":\"engineering-model-go\",\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.architecture_decision\",\"target\":\"ADR-EMG-018\",\"properties\":{\"Consequences\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"NAF architecture products and existing SysML, Structurizr, assurance, and document outputs share one source of truth.\"},{\"kind\":\"string\",\"string\":\"NAF viewpoint products cannot introduce private copies of system elements or relationships.\"},{\"kind\":\"string\",\"string\":\"Adding another NAF release requires an explicit versioned viewpoint registry and validation update.\"},{\"kind\":\"string\",\"string\":\"Generated NAF documents provide framework-aligned architecture descriptions but do not imply certification by NATO.\"}]},\"Context\":{\"kind\":\"string\",\"string\":\"The NATO Architecture Framework organizes architecture descriptions by stakeholders, concerns,\\nand viewpoint products. Its capability, service, logical, resource, and architecture concepts\\noverlap with concepts already represented by the canonical SysML and KerML aligned semantic graph.\\nCreating a separate NAF domain graph would duplicate those concepts and allow the two models to drift.\\n\"},\"Date\":{\"kind\":\"string\",\"string\":\"2026-09-19\"},\"Decision\":{\"kind\":\"string\",\"string\":\"Keep capability, service, logical, resource, behavior, interface, and requirement concepts in the\\ncanonical semantic graph. Author only NAF-specific profile metadata in YAML: framework version,\\narchitecture-description identity, stakeholder bindings, concerns, and official NAF viewpoint\\nselections. Each NAF architecture product references an existing Engmod view, and the NAF exporter\\nrenders that projection with stable canonical identifiers. Validate the profile with CUE and\\ncross-reference checks before generation.\\n\"},\"ID\":{\"kind\":\"string\",\"string\":\"ADR-EMG-018\"},\"Status\":{\"kind\":\"string\",\"string\":\"accepted\"},\"Title\":{\"kind\":\"string\",\"string\":\"Implement NAF 4.1 as a profile over canonical model views\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.architecture_decision\",\"targets\":[\"engineering-model-go\"]}";
    }
    attribute 'ADR-EMG-018';

    @EngineeringElement {
        sourceId = "ADR-EMG-019";
        conceptKind = "engineering_extension";
        payload = "{\"namespace\":\"engineering-model-go\",\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.architecture_decision\",\"target\":\"ADR-EMG-019\",\"properties\":{\"Consequences\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"Existing repositories and all generated output formats remain compatible.\"},{\"kind\":\"string\",\"string\":\"New models can declare their entire input document set in one discoverable location.\"},{\"kind\":\"string\",\"string\":\"AI agents can obtain a compact editing contract before reading broad YAML or Go implementation files.\"},{\"kind\":\"string\",\"string\":\"Future incompatible input changes require a new explicit schema version rather than silent reinterpretation.\"}]},\"Context\":{\"kind\":\"string\",\"string\":\"The canonical model is split across architecture, catalog, requirements, design, and decisions YAML.\\nOnly the catalog path was explicit; the remaining companion files were discovered through fixed names,\\nand none of the documents declared a common schema version. Humans could learn these conventions from\\nrepository history, but an AI agent had to infer them from loader code and multiple schemas.\\n\"},\"Date\":{\"kind\":\"string\",\"string\":\"2026-09-19\"},\"Decision\":{\"kind\":\"string\",\"string\":\"Add an optional schemaVersion field to every canonical YAML document and explicit companion-document\\nreferences under architecture.model.documents. Version 1 is the implicit value for existing inputs.\\nKeep baseCatalogRef and the established default filenames as compatibility adapters, reject conflicting\\nold and new catalog references, and expose the resolved document set, schema locations, top-level fields,\\nstable-ID conventions, and recommended authoring order through a model.authoringContract MCP tool.\\n\"},\"ID\":{\"kind\":\"string\",\"string\":\"ADR-EMG-019\"},\"Status\":{\"kind\":\"string\",\"string\":\"accepted\"},\"Title\":{\"kind\":\"string\",\"string\":\"Make the YAML document set self-describing without breaking legacy inputs\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.architecture_decision\",\"targets\":[\"engineering-model-go\"]}";
    }
    attribute 'ADR-EMG-019';

    @EngineeringElement {
        sourceId = "AV-MALFORMED-MODEL-INPUT";
        conceptKind = "engineering_extension";
        payload = "{\"namespace\":\"engineering-model-go\",\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.attack_vector\",\"target\":\"AV-MALFORMED-MODEL-INPUT\",\"properties\":{\"Description\":{\"kind\":\"string\",\"string\":\"Invalid or ambiguous model content causing incorrect parsing or graph interpretation.\"},\"ID\":{\"kind\":\"string\",\"string\":\"AV-MALFORMED-MODEL-INPUT\"},\"Name\":{\"kind\":\"string\",\"string\":\"Malformed Model Input\"}}},{\"namespace\":\"engineering\",\"type\":\"engineering.catalog.attack_vectors\",\"target\":\"AV-MALFORMED-MODEL-INPUT\",\"properties\":{\"Aliases\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"invalid model\"}]},\"Definition\":{\"kind\":\"string\",\"string\":\"Invalid or ambiguous model content that causes incorrect graph construction.\"},\"ID\":{\"kind\":\"string\",\"string\":\"AV-MALFORMED-MODEL-INPUT\"},\"Name\":{\"kind\":\"string\",\"string\":\"malformed model input\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.attack_vector\",\"targets\":[\"engineering-model-go\"]}";
    }
    attribute 'AV-MALFORMED-MODEL-INPUT';

