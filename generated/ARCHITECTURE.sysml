EER\"}]}}},{\"kind\":\"object\",\"object\":{\"Description\":{\"kind\":\"string\",\"string\":\"Model changes must progress through validation and deterministic artifact generation.\"},\"ID\":{\"kind\":\"string\",\"string\":\"NAF-CONCERN-LIFECYCLE\"},\"Name\":{\"kind\":\"string\",\"string\":\"Generation lifecycle\"},\"StakeholderRefs\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"ACT-ARCHITECTURE-AUTHOR\"},{\"kind\":\"string\",\"string\":\"ACT-IMPLEMENTATION-ENGINEER\"}]}}}]},\"Framework\":{\"kind\":\"string\",\"string\":\"NAF\"},\"Products\":{\"kind\":\"list\",\"list\":[{\"kind\":\"object\",\"object\":{\"ConcernRefs\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"NAF-CONCERN-ARCHITECTURE-COVERAGE\"}]},\"ID\":{\"kind\":\"string\",\"string\":\"NAF-A2-ARCHITECTURE-PRODUCTS\"},\"Title\":{\"kind\":\"string\",\"string\":\"Engineering Model architecture products\"},\"ViewRef\":{\"kind\":\"string\",\"string\":\"VIEW-ARCHITECTURE-INTENT\"},\"Viewpoint\":{\"kind\":\"string\",\"string\":\"A2\"}}},{\"kind\":\"object\",\"object\":{\"ConcernRefs\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"NAF-CONCERN-TRACEABILITY\"}]},\"ID\":{\"kind\":\"string\",\"string\":\"NAF-A3-ARCHITECTURE-CORRESPONDENCE\"},\"Title\":{\"kind\":\"string\",\"string\":\"Requirements and implementation correspondence\"},\"ViewRef\":{\"kind\":\"string\",\"string\":\"VIEW-TRACEABILITY\"},\"Viewpoint\":{\"kind\":\"string\",\"string\":\"A3\"}}},{\"kind\":\"object\",\"object\":{\"ConcernRefs\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"NAF-CONCERN-LIFECYCLE\"}]},\"ID\":{\"kind\":\"string\",\"string\":\"NAF-L6-LOGICAL-SEQUENCE\"},\"Title\":{\"kind\":\"string\",\"string\":\"Model change to verified artifact sequence\"},\"ViewRef\":{\"kind\":\"string\",\"string\":\"VIEW-INTERACTION-FLOW\"},\"Viewpoint\":{\"kind\":\"string\",\"string\":\"L6\"}}},{\"kind\":\"object\",\"object\":{\"ConcernRefs\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"st