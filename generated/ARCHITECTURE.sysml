":\"CLI Orchestration Intent\"}}},\"communication\":{\"kind\":\"object\",\"object\":{\"Narrative\":{\"kind\":\"string\",\"string\":\"Connects user/CI invocation context to loader, validator, and exporter units.\"},\"Title\":{\"kind\":\"string\",\"string\":\"CLI Orchestration Communication\"}}},\"deployment\":{\"kind\":\"object\",\"object\":{\"Narrative\":{\"kind\":\"string\",\"string\":\"Shipped as command binaries under cmd for task-specific execution.\"},\"Title\":{\"kind\":\"string\",\"string\":\"CLI Orchestration Deployment\"}}},\"security\":{\"kind\":\"object\",\"object\":{\"Narrative\":{\"kind\":\"string\",\"string\":\"Applies validation gates before producing or publishing artifacts.\"},\"Title\":{\"kind\":\"string\",\"string\":\"CLI Orchestration Security\"}}},\"traceability\":{\"kind\":\"object\",\"object\":{\"Narrative\":{\"kind\":\"string\",\"string\":\"Maintains deterministic invocation paths for reproducible artifact updates.\"},\"Title\":{\"kind\":\"string\",\"string\":\"CLI Orchestration Traceability\"}}}}}}},{\"kind\":\"object\",\"object\":{\"Group\":{\"kind\":\"string\",\"string\":\"FG-MODEL-AUTHORING\"},\"ID\":{\"kind\":\"string\",\"string\":\"FU-MODEL-CHANGE\"},\"Views\":{\"kind\":\"object\",\"object\":{\"architecture_intent\":{\"kind\":\"object\",\"object\":{\"Narrative\":{\"kind\":\"string\",\"string\":\"Provides a typed mutation boundary for authored model documents without duplicating model validation semantics.\"},\"Title\":{\"kind\":\"string\",\"string\":\"Model Change Intent\"}}},\"communication\":{\"kind\":\"object\",\"object\":{\"Narrative\":{\"kind\":\"string\",\"string\":\"Accepts versioned stable-ID operations and returns deterministic summaries plus structured diagnostics.\"},\"Title\":{\"kind\":\"string\",\"string\":\"Model Change Communication\"}}},\"deployment\":{\"kind\":\"object\",\"object\":{\"Narrative\":{\"kind\":\"string\",\"string\":\"Runs through the engchange CLI or reusable Go API in local developer workflows.\"},\"Title\":{\"kind\":\"string\",\"string\":\"Model Change Deployment\"}}},\"security\":{\"kind\":\"object\",\"object\":{\"Narrative\":{\"kind\":\"string\",\"string\":\"Rejects unknown fields, conflicting operations, stale source content, and invalid candidates before replacement.\"},\"Title\":{\"kind\":\"string\",\"string\":\"Model Change Security\"}}},\"traceability\":{\"kind\":\"object\",\"object\":{\"Narrative\":{\"kind\":\"string\",\"string\":\"Links each mutation behavior to requirements and preserves stable identifiers through the YAML AST merge.\"},\"Title\":{\"kind\":\"string\",\"string\":\"Model Change Traceability\"}}}}}}},{\"kind\":\"object\",\"object\":{\"Group\":{\"kind\":\"string\",\"string\":\"FG-MODEL-AUTHORING\"},\"ID\":{\"kind\":\"string\",\"string\":\"FU-SYSTEM-COMPOSITION\"},\"Views\":{\"kind\":\"object\",\"object\":{\"architecture_intent\":{\"kind\":\"object\",\"object\":{\"Narrative\":{\"kind\":\"string\",\"string\":\"Resolves a parent model's downward subsystem references into a federated system-of-systems, from local subdirectories or external git repositories.\"},\"Title\":{\"kind\":\"string\",\"string\":\"System Composition Intent\"}}},\"communication\":{\"kind\":\"object\",\"object\":{\"Narrative\":{\"kind\":\"string\",\"string\":\"Binds each subsystem's provides/requires contract to the parent's allocations and satisfactions without modifying the subsystem.\"},\"Title\":{\"kind\":\"string\",\"string\":\"System Composition Communication\"}}},\"deployment\":{\"kind\":\"object\",\"object\":{\"Narrative\":{\"kind\":\"string\",\"string\":\"External git subsystems are cloned once into the gitignored .engmod/subsystems cache and reused offline.\"},\"Title\":{\"kind\":\"string\",\"string\":\"System Composition Deployment\"}}},\"security\":{\"kind\":\"object\",\"object\":{\"Narrative\":{\"kind\":\"string\",\"string\":\"Enforces a workspace boundary and rejects references that escape it or form a cycle.\"},\"Title\":{\"kind\":\"string\",\"string\":\"System Composition Security\"}}},\"traceability\":{\"kind\":\"object\",\"object\":{\"Narrative\":{\"kind\":\"string\",\"string\":\"Reports cycle, out-of-workspace, missing-ref, clone-failed, and unsatisfied-require diagnostics for every subsystem reference.\"},\"Title\":{\"kind\":\"string\",\"string\":\"System Composition Traceability\"}}}}}}},{\"kind\":\"object\",\"object\":{\"Group\":{\"kind\":\"string\",\"string\":\"FG-TRACEABILITY-COMPLIANCE\"},\"ID\":{\"kind\":\"string\",\"string\":\"FU-ALLOCATION-TRACE\"},\"Views\":{\"kind\":\"object\",\"object\":{\"architecture_intent\":{\"kind\":\"object\",\"object\":{\"Narrative\":{\"kind\":\"string\",\"string\":\"Materializes parent-to-subsystem requirement delegation and the consolidated traceability matrix without modifying subsystem models.\"},\"Title\":{\"kind\":\"string\",\"string\":\"Allocation Trace Intent\"}}},\"communication\":{\"kind\":\"object\",\"object\":{\"Narrative\":{\"kind\":\"string\",\"string\":\"Emits the TRACE-MATRIX.json (and CSV) linking each requirement to its code, verification, and delegated subsystem requirement.\"},\"Title\":{\"kind\":\"string\",\"string\":\"Allocation Trace Communication\"}}},\"deployment\":{\"kind\":\"object\",\"object\":{\"Narrative\":{\"kind\":\"string\",\"string\":\"Run via engtrace or as part of engdoc; fails the build on dangling code trace links.\"},\"Title\":{\"kind\":\"string\",\"string\":\"Allocation Trace Deployment\"}}},\"security\":{\"kind\":\"object\",\"object\":{\"Narrative\":{\"kind\":\"string\",\"string\":\"Scopes code to the nearest enclosing model root so a parent never claims a child model's links.\"},\"Title\":{\"kind\":\"string\",\"string\":\"Allocation Trace Security\"}}},\"traceability\":{\"kind\":\"object\",\"object\":{\"Narrative\":{\"kind\":\"string\",\"string\":\"Rolls up requirement status as implemented, verified, delegated, or orphan, and flags untraceable delegations.\"},\"Title\":{\"kind\":\"string\",\"string\":\"Allocation Trace Traceability\"}}}}}}},