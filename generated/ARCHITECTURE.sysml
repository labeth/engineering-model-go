        attribute 'text' : 'String' = "Where external schema dependencies are available, when generation run is requested, the engineering model go shall fail validation if schema checks do not match expected constraints.";
        attribute 'notes' : 'String' = "Protect export integrity when schema trust fails.";
    }

    @EngineeringElement {
        sourceId = "REQ-EMG-012";
        conceptKind = "requirement_definition";
        payload = "{\"namespace\":\"engineering-model-go\",\"owner\":\"engineering-model-go\",\"features\":[{\"name\":\"text\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"When generation run is requested, the engineering model go shall generate artifacts deterministically so that regeneration is reproducible.\"}},{\"name\":\"notes\",\"kind\":\"attribute\",\"type\":\"String\",\"value\":{\"language\":\"literal\",\"value\":\"Generation uses stable ordering (sorted diagnostics, link targets, scan results) and excludes environment-specific inputs, so regenerated documents are bit-for-bit reproducible and the CI freshness gate can detect drift.\"}}],\"metadata\":[{\"namespace\":\"engineering\",\"type\":\"engineering.requirement_source\",\"target\":\"REQ-EMG-012\",\"properties\":{\"AppliesTo\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"FU-ASCIIDOC-GENERATOR\"},{\"kind\":\"string\",\"string\":\"FU-CODEMAP-INFERENCE\"},{\"kind\":\"string\",\"string\":\"FU-ALLOCATION-TRACE\"}]},\"ID\":{\"kind\":\"string\",\"string\":\"REQ-EMG-012\"},\"Notes\":{\"kind\":\"string\",\"string\":\"Generation uses stable ordering (sorted diagnostics, link targets, scan results) and excludes environment-specific inputs, so regenerated documents are bit-for-bit reproducible and the CI freshness gate can detect drift.\"},\"Text\":{\"kind\":\"string\",\"string\":\"When generation run is requested, the engineering model go shall generate artifacts deterministically so that regeneration is reproducible.\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.requirement_source\"}";
    }
    requirement def 'REQ-EMG-012' {
        attribute 'text' : 'String' = "When generation run is requested, the engineering model go shall generate artifacts deterministically so that regeneration is reproducible.";
        attribute 'notes' : 'String' = "Generation uses stable ordering (sorted diagnostics, link targets, scan results) and excludes environment-specific inputs, so regenerated documents are bit-for-bit reproducible and the CI freshness gate can detect drift.";
    }

