 claim.\"},\"Title\":{\"kind\":\"string\",\"string\":\"SysML Exporter Security\"}}},\"traceability\":{\"kind\":\"object\",\"object\":{\"Narrative\":{\"kind\":\"string\",\"string\":\"Preserves stable Engineering Model identifiers and emits executable coverage evidence for every mapped concept.\"},\"Title\":{\"kind\":\"string\",\"string\":\"SysML Exporter Traceability\"}}}}}}},{\"namespace\":\"engineering\",\"type\":\"engineering.catalog.functional_units\",\"target\":\"FU-SYSML-EXPORTER\",\"properties\":{\"Aliases\":{\"kind\":\"list\",\"list\":[{\"kind\":\"string\",\"string\":\"engsysml\"}]},\"Definition\":{\"kind\":\"string\",\"string\":\"Generates SysML v2 model artifacts from the canonical semantic model and reports conformance coverage.\"},\"ID\":{\"kind\":\"string\",\"string\":\"FU-SYSML-EXPORTER\"},\"Name\":{\"kind\":\"string\",\"string\":\"sysml exporter\"}}}],\"extensionNamespace\":\"engineering\",\"extension\":\"engineering.functional_unit\"}";
