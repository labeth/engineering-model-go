package engineering_model_go_lint
Requirement REQ_EMG_001 {
  id         = "REQ-EMG-001"
  text       = "While local development mode is active, when model updated event is received, the engineering model go shall validate architecture model before generation run is requested."
  notes      = "Validation must gate all generation flows."
  applies_to = ["FU-ASCIIDOC-GENERATOR", "FU-CLI-ORCHESTRATION", "FU-MODEL-LOADER", "FU-OSCAL-EXPORTER", "FU-STRUCTURIZR-EXPORTER", "FU-THREAT-EXPORTER", "FU-VALIDATION-ENGINE"]
}
Requirement REQ_EMG_003 {
  id         = "REQ-EMG-003"
  text       = "While model is valid, when generation run is requested, the engineering model go shall produce AsciiDoc architecture publication output without whitespace-only lines."
  notes      = "Human-readable architecture output remains required and shall be clean for version control and downstream processing."
  applies_to = ["FU-ASCIIDOC-GENERATOR", "FU-CLI-ORCHESTRATION", "FU-VIEW-PROJECTION"]
}
Requirement REQ_EMG_004 {
  id         = "REQ-EMG-004"
  text       = "Where threat export is enabled, when generation run is requested, the engineering model go shall export threat dragon json artifact plus open threat model artifact."
  notes      = "Threat model interchange output contract."
  applies_to = ["FU-CLI-ORCHESTRATION", "FU-THREAT-EXPORTER"]
}
Requirement REQ_EMG_005 {
  id         = "REQ-EMG-005"
  text       = "Where structurizr export is enabled, when generation run is requested, the engineering model go shall export structurizr dsl artifact."
  notes      = "Structurizr DSL is exported for C4 visualization; the exported DSL is validated best-effort by the validate-all gauntlet when a Structurizr validator is available."
  applies_to = ["FU-CLI-ORCHESTRATION", "FU-STRUCTURIZR-EXPORTER"]
}
Requirement REQ_EMG_006 {
  id         = "REQ-EMG-006"
  text       = "Where traceability export is enabled, when generation run is requested, the engineering model go shall produce trlc package and lobster trace report artifacts."
  notes      = "Traceability outputs required for assurance workflows."
  applies_to = ["FU-CLI-ORCHESTRATION", "FU-LOBSTER-EXPORTER", "FU-TRLC-EXPORTER"]
}
Requirement REQ_EMG_007 {
  id         = "REQ-EMG-007"
  text       = "While mcp server is enabled, when mcp tool call is received and catalog references resolve successfully, the engineering model go shall return mcp tool result with schema version and structured error fields."
  notes      = "MCP response contract stability requirement."
  applies_to = ["FU-MCP-SERVER"]
}
Requirement REQ_EMG_008 {
  id         = "REQ-EMG-008"
  text       = "When mcp tool call is received, the engineering model go shall reject path arguments outside repository workspace boundary."
  notes      = "Filesystem trust boundary guardrail."
  applies_to = ["FU-MCP-SERVER"]
}
Requirement REQ_EMG_009 {
  id         = "REQ-EMG-009"
  text       = "While ci validation mode is active, when generation run is requested, the engineering model go shall execute validation plus tests before artifact generated event is raised."
  notes      = "CI installs only the runtimes required by validation, uses mutually compatible exact validator versions and supported command-line semantics for those versions, and configures dependency caches only when their native project metadata exists, so setup and validation do not fail before the validation gauntlet completes."
  applies_to = ["FU-CLI-ORCHESTRATION", "FU-VALIDATION-ENGINE"]
}
Requirement REQ_EMG_010 {
  id         = "REQ-EMG-010"
  text       = "Where requirement trace is complete, when model updated event is received, the engineering model go shall infer traceability coverage from trace markers."
  notes      = "Links runtime, code, and test markers to modeled requirement coverage. Code and metadata scanning excludes dependency caches (node_modules, vendor) and dot-directories (.git, .engmod, tool caches) so coverage reflects only committed first-party source and stays reproducible."
  applies_to = ["FU-CODEMAP-INFERENCE"]
}
Requirement REQ_EMG_011 {
  id         = "REQ-EMG-011"
  text       = "Where external schema dependencies are available, when generation run is requested, the engineering model go shall fail validation if schema checks do not match expected constraints."
  notes      = "Protect export integrity when schema trust fails."
  applies_to = ["FU-STRUCTURIZR-EXPORTER", "FU-THREAT-EXPORTER", "FU-VALIDATION-ENGINE"]
}
Requirement REQ_EMG_012 {
  id         = "REQ-EMG-012"
  text       = "When generation run is requested, the engineering model go shall generate artifacts deterministically so that regeneration is reproducible."
  notes      = "Generation uses stable ordering and controlled metadata so maintained artifacts are bit-for-bit reproducible. The validation gauntlet regenerates every maintained example and applies authoritative parsers or schemas where available plus semantic and idiomatic checks for each published format."
  applies_to = ["FU-ALLOCATION-TRACE", "FU-ASCIIDOC-GENERATOR", "FU-CODEMAP-INFERENCE", "FU-GEMARA-EXPORTER", "FU-LOBSTER-EXPORTER", "FU-OSCAL-EXPORTER", "FU-STRUCTURIZR-EXPORTER", "FU-SYSML-EXPORTER", "FU-THREAT-EXPORTER", "FU-TRLC-EXPORTER", "FU-VALIDATION-ENGINE"]
}
Requirement REQ_EMG_013 {
  id         = "REQ-EMG-013"
  text       = "Where traceability export is enabled, when generation run is requested, the engineering model go shall export an OSCAL aggregate profile plus SSP plus assessment plan plus assessment results plus POA&M artifacts when the corresponding compliance and remediation content is applicable."
  notes      = "OSCAL documents use version 1.1.2 structures, deterministic metadata, resolvable sibling import links, aggregate every implemented compliance framework, and omit inapplicable documents rather than emitting schema-invalid empty artifacts."
  applies_to = ["FU-CLI-ORCHESTRATION", "FU-OSCAL-EXPORTER"]
}
Requirement REQ_EMG_014 {
  id         = "REQ-EMG-014"
  text       = "Where architecture decision records are authored, when generation run is requested, the engineering model go shall publish architecture decision records document linked from AsciiDoc architecture publication output."
  notes      = "ADRs are first-class model content but are published separately from the main architecture narrative."
  applies_to = ["FU-ASCIIDOC-GENERATOR", "FU-CLI-ORCHESTRATION"]
}
Requirement REQ_EMG_015 {
  id         = "REQ-EMG-015"
  text       = "Where gemara export is enabled, when generation run is requested, the engineering model go shall render OpenSSF Gemara model artifacts."
  notes      = "Gemara is a first-class GRC rendering of the model, validated against the published Gemara schemas via the go-gemara SDK."
  applies_to = ["FU-CLI-ORCHESTRATION", "FU-GEMARA-EXPORTER", "FU-MCP-SERVER"]
}
Requirement REQ_EMG_016 {
  id         = "REQ-EMG-016"
  text       = "Where system composition is enabled, when generation run is requested, the engineering model go shall resolve the subsystem references declared by the parent system from local subdirectory paths."
  notes      = "Recursive system-of-systems composition; local subdirectory references, with external git repositories cloned into the .engmod cache (REQ-EMG-027, ADR-EMG-008, ADR-EMG-010)."
  applies_to = ["FU-MODEL-LOADER", "FU-SYSTEM-COMPOSITION"]
}
Requirement REQ_EMG_017 {
  id         = "REQ-EMG-017"
  text       = "Where system composition is enabled, when generation run is requested, the engineering model go shall reject any subsystem reference that resolves outside the repository workspace boundary."
  notes      = "Downward-only references remain within the workspace; mirrors the MCP path-boundary guardrail."
  applies_to = ["FU-SYSTEM-COMPOSITION"]
}
Requirement REQ_EMG_018 {
  id         = "REQ-EMG-018"
  text       = "Where system composition is enabled, when generation run is requested, the engineering model go shall reject a subsystem reference graph that contains a cycle."
  notes      = "Subsystem references must form a directed acyclic graph (ADR-EMG-009)."
  applies_to = ["FU-SYSTEM-COMPOSITION", "FU-VALIDATION-ENGINE"]
}
Requirement REQ_EMG_019 {
  id         = "REQ-EMG-019"
  text       = "Where system composition is enabled, when generation run is requested, the engineering model go shall resolve cross-system references using subsystem-qualified identifiers."
  notes      = "Identifiers are scoped per system; cross-system references are qualified by subsystem to avoid collisions."
  applies_to = ["FU-ALLOCATION-TRACE", "FU-SYSTEM-COMPOSITION"]
}
Requirement REQ_EMG_020 {
  id         = "REQ-EMG-020"
  text       = "Where system composition is enabled, when generation run is requested, the engineering model go shall materialize parent-to-subsystem allocation traceability in the composed output without modifying any subsystem model."
  notes      = "A subsystem is parent-agnostic; parent allocation is materialized only in composed artifacts, never written back to the child (ADR-EMG-009, ADR-EMG-011)."
  applies_to = ["FU-ALLOCATION-TRACE"]
}
Requirement REQ_EMG_021 {
  id         = "REQ-EMG-021"
  text       = "Where system composition is enabled, when generation run is requested, the engineering model go shall report each subsystem required interface that the parent system does not satisfy."
  notes      = "Subsystems publish a provides-and-requires contract; the parent must satisfy each required interface."
  applies_to = ["FU-ALLOCATION-TRACE", "FU-VALIDATION-ENGINE"]
}
Requirement REQ_EMG_022 {
  id         = "REQ-EMG-022"
  text       = "Where system composition is enabled, when generation run is requested, the engineering model go shall reject an allocation that targets a subsystem identifier not published in the subsystem contract."
  notes      = "Parents may bind only to a subsystem's public contract surface, not its internal identifiers."
  applies_to = ["FU-ALLOCATION-TRACE", "FU-VALIDATION-ENGINE"]
}
Requirement REQ_EMG_023 {
  id         = "REQ-EMG-023"
  text       = "When generation run is requested, the engineering model go shall flag any requirement that links to another requirement in the same document."
  notes      = "Requirements carry no tiers. A requirement is either delegated to a subsystem through a downward composition allocation or implemented here, and the delegation link alone tells the two apart. Linking requirements to one another inside a document recreates tier coupling and is confusing across system boundaries, so it is flagged."
  applies_to = ["FU-ALLOCATION-TRACE", "FU-VALIDATION-ENGINE"]
}
Requirement REQ_EMG_024 {
  id         = "REQ-EMG-024"
  text       = "Where hardware interfaces are authored, when generation run is requested, the engineering model go shall render the hardware to software interface allocation view."
  notes      = "Hardware items and hardware interfaces capture the HW/SW interface (ICD/IRS) for the interface-control view."
  applies_to = ["FU-ASCIIDOC-GENERATOR", "FU-VIEW-PROJECTION"]
}
Requirement REQ_EMG_025 {
  id         = "REQ-EMG-025"
  text       = "Where system composition is enabled, when generation run is requested, the engineering model go shall produce a system requirement allocation matrix aggregated across the composed subsystems."
  notes      = "Aggregate roll-up generation mode for the integrating system."
  applies_to = ["FU-ALLOCATION-TRACE", "FU-ASCIIDOC-GENERATOR"]
}
Requirement REQ_EMG_026 {
  id         = "REQ-EMG-026"
  text       = "Where system composition is enabled, when generation run is requested, the engineering model go shall render in the requirement view the delegation link from each delegated requirement to the specific subsystem requirement that satisfies it."
  notes      = "A provided contract entry names (ref) the subsystem requirement that realizes it, so a parent delegation traces to exactly the requirement that satisfies it. An allocated capability with no such ref is flagged as untraceable, and a ref to a requirement the subsystem does not define is rejected."
  applies_to = ["FU-ALLOCATION-TRACE", "FU-ASCIIDOC-GENERATOR", "FU-VALIDATION-ENGINE"]
}
Requirement REQ_EMG_027 {
  id         = "REQ-EMG-027"
  text       = "Where system composition is enabled, when generation run is requested, the engineering model go shall resolve an external git subsystem reference by cloning the repository into the workspace .engmod cache."
  notes      = "A subsystem may reference an external repository with git (and an optional rev and path). The model is cloned once into .engmod/subsystems/<id> — a gitignored, temporary cache reused while it points at the same repository — and resolved like a local subsystem, giving a full cross-repository composed view. References stay downward-only."
  applies_to = ["FU-MODEL-LOADER", "FU-SYSTEM-COMPOSITION"]
}
Requirement REQ_EMG_028 {
  id         = "REQ-EMG-028"
  text       = "When generation run is requested, the engineering model go shall reject a code trace link that resolves to no requirement or model element."
  notes      = "Code markers (TRLC-LINKS to a requirement, ENGMODEL-LINKS to a model element) are existence-checked against the model, not only shape-checked, so a link to a deleted or mistyped id is a dangling link and fails the build. A trace link is only checked for the model that owns its code (see REQ-EMG-030 scoping)."
  applies_to = ["FU-ALLOCATION-TRACE", "FU-CODEMAP-INFERENCE", "FU-VALIDATION-ENGINE"]
}
Requirement REQ_EMG_029 {
  id         = "REQ-EMG-029"
  text       = "When generation run is requested, the engineering model go shall flag each requirement that is traced by neither code nor verification nor a downward delegation."
  notes      = "An orphan requirement has no implementing code symbol, no verification, and is not delegated to a subsystem; it is a coverage gap surfaced as a warning so it is visible without breaking the build."
  applies_to = ["FU-ALLOCATION-TRACE", "FU-VALIDATION-ENGINE"]
}
Requirement REQ_EMG_030 {
  id         = "REQ-EMG-030"
  text       = "When generation run is requested, the engineering model go shall export a machine-readable traceability matrix that links each requirement to its implementing code and verification and delegated subsystem requirement."
  notes      = "One consolidated matrix (JSON) replaces having to read it out of prose and diagrams. Code is attributed to the model whose architecture.yml is its nearest enclosing root, so a parent model never validates or counts a child model's trace links (monorepo scoping)."
  applies_to = ["FU-ALLOCATION-TRACE", "FU-CODEMAP-INFERENCE"]
}
Requirement REQ_EMG_031 {
  id         = "REQ-EMG-031"
  text       = "When requirements delta is received, the engineering model go shall strictly validate requirements delta schema plus stable identifier operation uniqueness."
  notes      = "Version 1 supports add, whole-entity update, and remove operations. Unknown fields, empty operations, duplicate operations, adds of existing IDs, and updates or removals of missing IDs are rejected."
  applies_to = ["FU-MODEL-CHANGE", "FU-MODEL-LOADER"]
}
Requirement REQ_EMG_032 {
  id         = "REQ-EMG-032"
  text       = "While dry run mode is active, when requirements delta is received, the engineering model go shall validate candidate architecture model without modifying requirements document."
  notes      = "The candidate reuses complete-model structural, catalog, EARS, and internal-link validation before any write is permitted."
  applies_to = ["FU-MODEL-CHANGE", "FU-VALIDATION-ENGINE"]
}
Requirement REQ_EMG_033 {
  id         = "REQ-EMG-033"
  text       = "While model is valid, when requirements delta apply is requested, the engineering model go shall atomically replace requirements document."
  notes      = "The YAML AST merger preserves unchanged nodes and comments. Atomic replacement preserves file permissions and refuses a candidate with blocking diagnostics."
  applies_to = ["FU-CLI-ORCHESTRATION", "FU-MODEL-CHANGE", "FU-VALIDATION-ENGINE"]
}
Requirement REQ_EMG_034 {
  id         = "REQ-EMG-034"
  text       = "When requirements delta is received, the engineering model go shall produce deterministic requirements change summary."
  notes      = "The summary sorts added, updated, and removed stable IDs and reports changed fields for whole-entity updates."
  applies_to = ["FU-CLI-ORCHESTRATION", "FU-MODEL-CHANGE"]
}
Requirement REQ_EMG_035 {
  id         = "REQ-EMG-035"
  text       = "When model updated event is received, the engineering model go shall normalize architecture model plus requirements document into canonical semantic model."
  notes      = "The canonical semantic model is SysML v2 and KerML aligned. Existing Engineering Model concepts map into that model once; legacy YAML remains an input adapter during migration and must not create a parallel set of parts, interfaces, flows, requirements, allocations, or views."
  applies_to = ["FU-MODEL-LOADER", "FU-SYSML-EXPORTER", "FU-VALIDATION-ENGINE"]
}
Requirement REQ_EMG_036 {
  id         = "REQ-EMG-036"
  text       = "Where sysml export is enabled, when generation run is requested, the engineering model go shall generate sysml v2 model artifact from canonical semantic model."
  notes      = "The exporter preserves stable identifiers and maps standard concepts to native SysML v2 or KerML semantics. Engineering-specific concepts may use explicit typed SysML metadata definitions, but canonical data without a native target representation must be omitted rather than encoded in descriptions, opaque payloads, generic property bags, or sidecar files."
  applies_to = ["FU-CLI-ORCHESTRATION", "FU-SYSML-EXPORTER", "FU-VALIDATION-ENGINE"]
}
Requirement REQ_EMG_037 {
  id         = "REQ-EMG-037"
  text       = "While ci validation mode is active, when generation run is requested, the engineering model go shall validate sysml v2 model artifact before artifact generated event is raised."
  notes      = "Validation must report unsupported or lossy mappings and progress toward abstract-syntax, textual-syntax, semantic, and model-interchange conformance. A syntactically valid subset export must not be described as a complete SysML v2 semantic superset."
  applies_to = ["FU-CLI-ORCHESTRATION", "FU-SYSML-EXPORTER", "FU-VALIDATION-ENGINE"]
}
Requirement REQ_EMG_038 {
  id         = "REQ-EMG-038"
  text       = "Where sysml export is enabled, when generation run is requested, the engineering model go shall validate canonical semantic model against sysml v2 metamodel."
  notes      = "The pinned formal SysML 2.0 and KerML 1.0 metamodel is the source of truth for supported classes, properties, relationships, ownership, and multiplicities. Generated CUE constraints and semantic registries must not be maintained as independent handwritten copies."
  applies_to = ["FU-MODEL-LOADER", "FU-SYSML-EXPORTER", "FU-VALIDATION-ENGINE"]
}
Requirement REQ_EMG_039 {
  id         = "REQ-EMG-039"
  text       = "While ci validation mode is active, when generation run is requested, the engineering model go shall reject incomplete sysml v2 metamodel coverage."
  notes      = "Coverage is complete only when every normative metaclass and property in the pinned formal release is represented, explicitly excluded as derived, or implemented as a typed Engineering Model extension with executable evidence."
  applies_to = ["FU-CLI-ORCHESTRATION", "FU-SYSML-EXPORTER", "FU-VALIDATION-ENGINE"]
}
Requirement REQ_EMG_040 {
  id         = "REQ-EMG-040"
  text       = "When generation run is requested, the engineering model go shall preserve the deterministic native sysml v2 source through project interchange round trip."
  notes      = "Sysand owns normative KPAR packaging and reopening. Verification compares the reopened SysML source byte-for-byte with a fresh projection and validates both sources with the pinned official parser; it does not claim lossless reconstruction of canonical concepts omitted from SysML."
  applies_to = ["FU-CLI-ORCHESTRATION", "FU-SYSML-EXPORTER", "FU-VALIDATION-ENGINE"]
}
Requirement REQ_EMG_041 {
  id         = "REQ-EMG-041"
  text       = "Where naf profile authoring is enabled, when model updated event is received, the engineering model go shall validate naf v4.1 stakeholder plus concern plus viewpoint metadata against canonical model references."
  notes      = "NAF-specific YAML contains profile metadata only. Capability, service, logical, resource, behavior, interface, and requirement concepts remain represented once in the canonical SysML and KerML aligned semantic graph."
  applies_to = ["FU-MODEL-LOADER", "FU-NAF-EXPORTER", "FU-VALIDATION-ENGINE"]
}
Requirement REQ_EMG_042 {
  id         = "REQ-EMG-042"
  text       = "Where naf export is enabled, when generation run is requested, the engineering model go shall generate deterministic naf v4.1 architecture document from referenced canonical model views."
  notes      = "Each NAF architecture product uses an official NAF v4.1 viewpoint code and references an existing Engmod view so generated content preserves canonical identities and relationships."
  applies_to = ["FU-CLI-ORCHESTRATION", "FU-NAF-EXPORTER", "FU-VIEW-PROJECTION"]
}
Requirement REQ_EMG_043 {
  id         = "REQ-EMG-043"
  text       = "While ci validation mode is active, when generation run is requested, the engineering model go shall reject unsupported naf version plus unknown viewpoint code plus dangling profile reference before artifact generated event is raised."
  notes      = "Validation covers stakeholder actor bindings, concern ownership, architecture-product concern references, and Engmod view references."
  applies_to = ["FU-CLI-ORCHESTRATION", "FU-NAF-EXPORTER", "FU-VALIDATION-ENGINE"]
}
Requirement REQ_EMG_044 {
  id         = "REQ-EMG-044"
  text       = "When model updated event is received, the engineering model go shall load schema version 2 engmod manifest plus catalog plus requirements plus architecture plus behavior plus assurance plus compliance plus views plus decisions documents into one canonical semantic model."
  notes      = "engmod.yml is the only model entry point and every document path is explicit. YAML is the authoring format and CUE is the schema authority. Requirements may carry format-neutral qualification metadata such as title, category, rationale, source references, verification methods and criteria, priority, criticality, status, derived disposition, and tags. Views own design narratives plus generic document definitions, document-control metadata, content selections, authored sections, and external references; architecture does not contain behavior, assurance, compliance, dependency source, NAF, or projection-specific declarations."
  applies_to = ["FU-CLI-ORCHESTRATION", "FU-MODEL-LOADER", "FU-VALIDATION-ENGINE"]
}
Requirement REQ_EMG_045 {
  id         = "REQ-EMG-045"
  text       = "While mcp server is enabled, when mcp tool call is received and catalog references resolve successfully, the engineering model go shall return schema version 2 model authoring contract."
  notes      = "The contract contains the manifest document map, authoritative CUE schema for each domain document, stable-ID and typed-relationship conventions, dependency publication aliases, valid references, and recommended task-scoped authoring order."
  applies_to = ["FU-MCP-SERVER", "FU-MODEL-LOADER"]
}
Requirement REQ_EMG_046 {
  id         = "REQ-EMG-046"
  text       = "While ci validation mode is active, when generation run is requested, the engineering model go shall reject model input that violates the schema version 2 manifest or any referenced domain document contract before artifact generated event is raised."
  notes      = "Missing documents, unsupported versions, unknown fields, duplicate concepts, invalid document-control values, incomplete derived requirement rationale, unresolved document content selections, unresolved local or qualified references, dependency publication violations, and cross-domain ownership violations are blocking."
  applies_to = ["FU-CLI-ORCHESTRATION", "FU-MODEL-LOADER", "FU-VALIDATION-ENGINE"]
}
Requirement REQ_EMG_047 {
  id         = "REQ-EMG-047"
  text       = "Where system composition is enabled, when generation run is requested, the engineering model go shall resolve each exact CUE module version from the OCI registry configured by CUE_REGISTRY."
  notes      = "Dependencies are declared only in engmod.yml with an alias, major-qualified module path, exact semantic version, and selected publications. The resolved module contains engmod.yml, its domain documents, and cue.mod/module.cue."
  applies_to = ["FU-MODEL-LOADER", "FU-SYSTEM-COMPOSITION"]
}
Requirement REQ_EMG_048 {
  id         = "REQ-EMG-048"
  text       = "Where a model workspace replacement is declared, when generation run is requested, the engineering model go shall resolve the matching manifest dependency from the replacement repository without changing module identity or selected publications."
  notes      = "engmod.work.yml maps module paths to local repositories for offline multi-repository development. A generated engmod.lock.yml records exact module versions and OCI digests but is not an authored semantic document."
  applies_to = ["FU-MODEL-LOADER", "FU-SYSTEM-COMPOSITION"]
}
Requirement REQ_EMG_049 {
  id         = "REQ-EMG-049"
  text       = "While ci validation mode is active, when generation run is requested, the engineering model go shall reject invalid manifest dependency plus publication plus workspace replacement plus qualified reference declarations."
  notes      = "Every dependency requires one alias, one major-qualified module path, one exact version, and at least one exported publication. Aliases are unique, module identities match cue.mod/module.cue, workspace paths remain contained, imported references use alias double-colon stable-id syntax, and transitive entities are unavailable unless re-exported."
  applies_to = ["FU-CLI-ORCHESTRATION", "FU-SYSTEM-COMPOSITION", "FU-VALIDATION-ENGINE"]
}
Requirement REQ_EMG_050 {
  id         = "REQ-EMG-050"
  text       = "When example validation is requested, the engineering model go shall validate a schema version 2 company portfolio composed from multiple product systems that reuse published hardware plus software plus security plus compliance facets across repository boundaries."
  notes      = "The reference workspace demonstrates explicit domain documents, dependency publication selection, qualified imported references, requirement delegation, contract satisfaction, inherited company controls, technical security controls, employee lifecycle compliance, provenance, exact OCI coordinates, local workspace replacements, and complete native format projections."
  applies_to = ["FU-ASCIIDOC-GENERATOR", "FU-GEMARA-EXPORTER", "FU-OSCAL-EXPORTER", "FU-SYSML-EXPORTER", "FU-SYSTEM-COMPOSITION", "FU-VALIDATION-ENGINE"]
}
Requirement REQ_EMG_051 {
  id         = "REQ-EMG-051"
  text       = "Where system composition is enabled, when generation run is requested, the engineering model go shall import only explicitly selected dependency publications with qualified identity plus source provenance."
  notes      = "Each dependency publication exposes typed architecture, behavior, assurance, compliance, requirement, and view references. Imported entities retain module path, exact version, digest, source model, and publication identity; unexported dependency entities remain inaccessible."
  applies_to = ["FU-CLI-ORCHESTRATION", "FU-MODEL-LOADER", "FU-SYSTEM-COMPOSITION", "FU-VALIDATION-ENGINE"]
}
Requirement REQ_EMG_052 {
  id         = "REQ-EMG-052"
  text       = "Where six-view example output is enabled, when generation run is requested, the engineering model go shall generate deterministic use-case plus logical plus process plus physical plus implementation plus deployment view artifacts and native SysML from one schema version 2 YAML bundle."
  notes      = "The acceptance example preserves viewpoint separation, hierarchical capabilities, ordered typed interactions, nested hardware and software structures, ports, connections, engineering values, and software-to-hardware allocations. Mermaid sources and SVG renderings are generated without depending on authored SysML source files."
  applies_to = ["FU-CLI-ORCHESTRATION", "FU-MODEL-LOADER", "FU-SYSML-EXPORTER", "FU-VIEW-PROJECTION"]
}
Requirement REQ_EMG_053 {
  id         = "REQ-EMG-053"
  text       = "Where do-178c dal c readiness output is enabled, when model updated event is received, the engineering model go shall load a strict aviation assurance profile plus lifecycle data plus verification evidence plus configuration baselines plus tool assessments plus structural coverage summaries."
  notes      = "The model references DO-178C or ED-12C and customer-controlled licensed objective identifiers without reproducing normative objective text. It distinguishes declared, planned, executed, reviewed, accepted, not-applicable, and authority-accepted evidence states."
  applies_to = ["FU-AIRBORNE-ASSURANCE-EXPORTER", "FU-MODEL-LOADER", "FU-VALIDATION-ENGINE"]
}
Requirement REQ_EMG_054 {
  id         = "REQ-EMG-054"
  text       = "Where do-178c dal c readiness output is enabled, when generation run is requested, the engineering model go shall reject incomplete or inconsistent requirement classification plus derived requirement disposition plus verification chain plus independence plus baseline plus structural coverage plus tool assessment evidence."
  notes      = "DAL assignment and objective applicability remain externally authorized inputs. Statement coverage is imported evidence tied to an exact build and environment; the tool does not perform safety assessment, coverage measurement, reviewer qualification, tool qualification, or certification approval."
  applies_to = ["FU-AIRBORNE-ASSURANCE-EXPORTER", "FU-VALIDATION-ENGINE"]
}
Requirement REQ_EMG_055 {
  id         = "REQ-EMG-055"
  text       = "Where do-178c dal c readiness output is enabled, when generation run is requested, the engineering model go shall generate deterministic draft lifecycle data index plus objective evidence matrix plus requirements trace matrix plus verification summary plus structural coverage summary plus tool assessment register plus configuration index plus open gap report plus software accomplishment summary."
  notes      = "Every output is visibly marked as draft evidence-readiness material, identifies its source baseline and unresolved gaps, and states that responsible human review plus configuration control plus certification authority acceptance remain required."
  applies_to = ["FU-AIRBORNE-ASSURANCE-EXPORTER", "FU-CLI-ORCHESTRATION"]
}
Requirement REQ_EMG_056 {
  id         = "REQ-EMG-056"
  text       = "When example validation is requested, the engineering model go shall validate a schema version 2 DAL C flight control software example with placeholder planning plus requirements plus design plus code plus verification plus coverage plus configuration plus quality assurance plus certification liaison evidence."
