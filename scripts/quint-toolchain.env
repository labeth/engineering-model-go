# Pinned Quint toolchain for formal behavior verification (ADR-EMG-041).
# Quint runs with the TypeScript backend only: the default Rust backend
# downloads its evaluator at run time. `verify` mode uses the Apalache
# distribution installed below, offline, through QUINT_HOME.
QUINT_VERSION=0.33.1
# Quint 0.33.1 defaults to this Apalache version; a different version would
# make Quint look for (and download) another distribution directory.
APALACHE_VERSION=0.62.4
APALACHE_SHA256=8ac8488422c30d552735bae11b92a2d014d8e02e8608702acc08f9a2d8a9abb2
# Java 21 or newer is required by Apalache; CI sets it up with actions/setup-java.
